  /* Responsive */
  /* Circuit Background Animation */
  .circuit-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 0.8;
  }

  .circuit-svg {
    width: 100%;
    height: 100%;
  }

  .circuit-path {
    fill: none;
    stroke: rgba(0, 0, 0, 0.08);
    stroke-width: 1.5;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: drawCircuit 3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .circuit-node {
    fill: rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform-origin: center;
    /* Combine fadeIn with a constant slow pulse */
    animation: fadeInNode 0.5s ease forwards, pulseNode 3s ease-in-out infinite alternate;
  }

  /* Staggered animations */
  .path-1 { animation-delay: 0.5s; }
  .node-1 { animation-delay: 2.0s; }
  
  .path-2 { animation-delay: 1.2s; }
  .node-2 { animation-delay: 2.7s; }

  .path-3 { animation-delay: 0.8s; }
  .node-3 { animation-delay: 2.3s; }

  .path-4 { animation-delay: 1.5s; }
  .node-4 { animation-delay: 3.0s; }

  @keyframes drawCircuit {
    0% { stroke-dashoffset: 1000; opacity: 0; }
    10% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }

  @keyframes fadeInNode {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
  
  @keyframes pulseNode {
    0% { transform: scale(1); fill: rgba(0, 0, 0, 0.15); }
    100% { transform: scale(1.6); fill: rgba(0, 0, 0, 0.3); }
  }

  @media (max-width: 992px) {
    .circuit-bg { opacity: 0.4; }
    .hero { padding-top: 8rem; }
    .hero-grid { grid-template-columns: 1fr; text-align: center; gap: 4rem; }
    .hero-content { text-align: center; margin: 0 auto; }
    .hero-actions { justify-content: center; }
    .hero-visual { height: 350px; margin-top: 2rem; }
    .card-hackathon { left: 0%; width: 280px; }
