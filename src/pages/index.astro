  }


  
  
  /* --- iPad Power Button & Boot Sequence --- */
  .ipad-power-btn {
    position: absolute;
    top: -3px;
    left: 80px;
    width: 40px;
    height: 3px;
    background: #a0a0a5;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    z-index: 50;
  }

  .ipad-power-btn:hover {
    background: #fff;
  }
  
  .ipad-power-btn:active {
    transform: translateY(2px);
  }

  .ipad-boot-screen {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: #000;
    z-index: 15;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0; /* Initially off (black screen is achieved by ipad-screen bg) */
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  
  /* When booting state is active */
  .ipad-boot-screen.booting {
    opacity: 1;
  }
  
  /* When boot is done, hide it */
  .ipad-boot-screen.hidden {
    opacity: 0;
    visibility: hidden;
  }

  .boot-logo {
    width: 60px;
    height: 60px;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 1s ease, transform 1s ease;
  }
  
  .ipad-boot-screen.booting .boot-logo {
    opacity: 1;
    transform: scale(1);
  }

  .boot-progress-bar {
    width: 120px;
    height: 3px;
    background: #333;
    border-radius: 2px;
    margin-top: 30px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s ease 0.5s;
  }
  
  .ipad-boot-screen.booting .boot-progress-bar {
    opacity: 1;
  }

  .boot-progress-fill {
    height: 100%;
    width: 0%;
    background: #fff;
    border-radius: 2px;
    transition: width 2.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .ipad-boot-screen.booting .boot-progress-fill {
    width: 100%;
  }

  /* Main UI State */
  #ipad-main-ui {
    transition: opacity 0.8s ease 0.2s, filter 0.8s ease;
  }
  
  #ipad-main-ui.off {
    opacity: 0;
    filter: blur(10px);
    pointer-events: none;
  }
  
  #ipad-main-ui.on {
    opacity: 1;
    filter: blur(0px);
    pointer-events: all;
  }
  
  /* Initially the screen is totally black, so we need to hide the wallpaper gradient */
  .ipad-screen.off {
    background: #000 !important;
  }
  
  .ipad-screen.off::before {
    opacity: 0 !important;
  }
  /* --- End Boot CSS --- */

  /* --- iPad Pro Wrapper --- */
  .ipad-pro-wrapper {
    max-width: 1024px;
    margin: 0 auto;
    background: #d1d1d6; /* Silver edge */
    border-radius: 38px;
    padding: 3px; 
    box-shadow: 
      inset 0 0 2px rgba(255, 255, 255, 0.8),
      inset 0 0 6px rgba(0, 0, 0, 0.2),
      0 20px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(0, 0, 0, 0.1);
    position: relative;
    /* Optional 3D tilt effect */
    transform: perspective(1200px) rotateX(4deg);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ipad-pro-wrapper:hover {
    transform: perspective(1200px) rotateX(0deg);
  }

  .ipad-pro-inner {
    background: #0f0f11; /* Deep black bezel */
    border-radius: 35px;
    padding: 24px; /* Bezel thickness */
    position: relative;
    box-shadow: inset 0 0 0 2px #000, inset 0 0 8px rgba(0,0,0,0.8);
  }

  .ipad-notch {
    position: absolute;
    top: 23px; 
    left: 50%;
    transform: translateX(-50%);
    width: 130px;
    height: 28px;
    background: #000;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    z-index: 20; /* Ensure it stays above the screen content */
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 -1px 3px rgba(255,255,255,0.1), 0 5px 10px rgba(0,0,0,0.5);
  }

  .ipad-camera {
    position: relative;
    width: 10px;
    height: 10px;
    background: #050505;
    border-radius: 50%;
    border: 1px solid #222;
    box-shadow: inset 0 0 3px #000, 0 0 2px rgba(255,255,255,0.05);
  }

  .ipad-camera::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 3px;
    height: 3px;
    background: rgba(30, 80, 200, 0.7);
    border-radius: 50%;
    filter: blur(0.5px);
  }

  .ipad-screen {
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 0 10px rgba(0,0,0,1);
    display: flex;
    /* iPad aesthetic wallpaper */
    background: radial-gradient(circle at top left, #1a0b2e 0%, #000000 60%),
                radial-gradient(circle at bottom right, #0d1b2a 0%, transparent 50%);
  }
  
  .ipad-screen::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('https://www.transparenttextures.com/patterns/stardust.png');
    opacity: 0.2;
    z-index: 0;
  }

  @media (max-width: 768px) {
    .ipad-pro-wrapper {
      margin: 0 1rem;
      border-radius: 28px;
      padding: 2px;
    }
    .ipad-pro-inner {
      border-radius: 26px;
      padding: 16px;
    }
    .ipad-notch {
      top: 50%;
      left: 16px; /* Touch the left screen edge */
      transform: translateY(-50%);
      width: 25px;
      height: 100px;
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      border-top-right-radius: 16px;
      border-bottom-right-radius: 16px;
      box-shadow: inset -2px 0 5px rgba(0,0,0,0.5);
    }
  }

  /* --- Glowing Screen Tab Section --- */
  .glowing-screen-section {
    padding: 4rem 0 6rem;
    position: relative;
    overflow: hidden;
  }

  /* Animated Conic Gradient for the Border */
  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .glowing-tab-wrapper {
    width: 100%;
    padding: 2px;
    border-radius: 16px;
    background: conic-gradient(from var(--angle), rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.1));
    animation: rotate-gradient 4s linear infinite;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.2), inset 0 0 20px rgba(255, 255, 255, 0.1);
    position: relative;
  }

  @keyframes rotate-gradient {
    0% { --angle: 0deg; }
    100% { --angle: 360deg; }
  }

  .glowing-tab-border {
    background-color: rgba(10, 10, 15, 0.4); /* Much more transparent */
    border-radius: 14px;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.05);
    height: 100%;
    width: 100%;
    z-index: 1;
    position: relative;
  }

  .glowing-tab-content {
    position: relative;
    z-index: 2;
    padding: 3rem;
  }

  .glowing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
