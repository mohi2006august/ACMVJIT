    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  /* Info Pane Styles */
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .info-item {
    display: flex;
