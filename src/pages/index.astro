---
import Layout from '../layouts/Layout.astro';
import leadsData from '../data/leads.json';
---

<Layout 
  title="Home" 
  isHome={true}
  description="Welcome to the official ACM VJIT Student Chapter. Join the ultimate CSE(AI&ML) community at Vidya Jyothi Institute of Technology. Explore coding hackathons, technical seminars, open-source projects, and industry networking."
>
  <!-- Hero Section -->
  <section class="hero">
    
    <!-- Aesthetic Circuit Traces Background -->
    <div class="circuit-bg">
      <svg class="circuit-svg" viewBox="0 0 1000 600" preserveAspectRatio="none">
        <!-- Left circuit traces -->
        <path class="circuit-path path-1" d="M -50 450 L 150 450 L 200 400 L 200 300 L 250 250" />
        <circle class="circuit-node node-1" cx="250" cy="250" r="3.5" />
        
        <path class="circuit-path path-2" d="M -50 150 L 100 150 L 150 200 L 250 200 L 300 150" />
        <circle class="circuit-node node-2" cx="300" cy="150" r="3.5" />
        <circle class="circuit-node node-2" cx="150" cy="200" r="2.5" />

        <!-- Right circuit traces -->
        <path class="circuit-path path-3" d="M 1050 100 L 850 100 L 800 150 L 800 250 L 750 300" />
        <circle class="circuit-node node-3" cx="750" cy="300" r="3.5" />

        <path class="circuit-path path-4" d="M 1050 500 L 900 500 L 850 450 L 700 450 L 650 400" />
        <circle class="circuit-node node-4" cx="650" cy="400" r="3.5" />
        <circle class="circuit-node node-4" cx="850" cy="450" r="2.5" />
      </svg>
    </div>

    <div class="container hero-single" style="position: relative; z-index: 2;">
      <div class="hero-badge"><span id="typewriter"></span><span class="cursor">|</span></div>
      
      <h1 class="hero-title-aesthetic">
        ACM VJIT
      </h1>

      <p class="hero-subtitle centered-subtitle">
        We bring together students passionate about computing — from algorithms to applications. Through events, mentorship, and a strong community, we turn concepts into working solutions.
      </p>
      
      <div class="hero-actions centered-actions">
        <a href="/recruitment" class="btn btn-primary">Join ACM VJIT</a>
        <a href="/events" class="btn btn-outline">Explore Events</a>
      </div>
    </div>
  </section>


  <!-- About Sticky Cards Section -->
  <section class="section sticky-cards-section">
    <div class="container">
      <div class="sticky-cards-wrapper">
        <!-- Card 1: ACM VJIT (Text Left, Card Right) -->
        <div class="scrolling-card scroll-reveal">
          <div class="sticky-card-inner">
            <div class="card-text">
              <p class="sticky-card-desc">The ACM VJIT Student Chapter is a dedicated academic and professional organization. We facilitate the transition from theoretical computing principles to applied industry practices. Our initiatives provide members with comprehensive technical skill development, structured mentorship programs, and exposure to cutting-edge research.</p>
            </div>
            <div class="card-visual">
              <div class="retro-cassette">
                <div class="screw top-left">+</div>
                <div class="screw top-right">+</div>
                <div class="screw bottom-left">+</div>
                <div class="screw bottom-right">+</div>
                
                <div class="cassette-sticker">
                  <div class="sticker-top">
                    <span class="sticker-index">A</span>
                    <span class="sticker-side">SIDE</span>
                  </div>
                  <div class="sticker-title">
                    <span>ABOUT</span>
                    <strong>ACM VJIT</strong>
                  </div>
                  <div class="color-stripes"></div>
                </div>
                
                <div class="cassette-window">
                  <div class="reel reel-left"><div class="reel-hub"></div><div class="reel-teeth"></div></div>
                  <div class="reel reel-right"><div class="reel-hub"></div><div class="reel-teeth"></div></div>
                </div>
                
                <div class="cassette-bottom">
                  <div class="cutout"></div>
                  <div class="cutout-large"></div>
                  <div class="cutout"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: ACM (Card Left, Text Right) -->
        <div class="scrolling-card scroll-reveal">
          <div class="sticky-card-inner">
            <div class="card-visual">
              <div class="retro-cassette">
                <div class="screw top-left">+</div>
                <div class="screw top-right">+</div>
                <div class="screw bottom-left">+</div>
                <div class="screw bottom-right">+</div>
                
                <div class="cassette-sticker">
                  <div class="sticker-top">
                    <span class="sticker-index">A</span>
                    <span class="sticker-side">SIDE</span>
                  </div>
                  <div class="sticker-title">
                    <span>ABOUT</span>
                    <strong>ACM</strong>
                  </div>
                  <div class="color-stripes"></div>
                </div>
                
                <div class="cassette-window">
                  <div class="reel reel-left"><div class="reel-hub"></div><div class="reel-teeth"></div></div>
                  <div class="reel reel-right"><div class="reel-hub"></div><div class="reel-teeth"></div></div>
                </div>
                
                <div class="cassette-bottom">
                  <div class="cutout"></div>
                  <div class="cutout-large"></div>
                  <div class="cutout"></div>
                </div>
              </div>
            </div>
            <div class="card-text">
              <p class="sticky-card-desc">The Association for Computing Machinery is the world's largest educational and scientific computing society, delivering resources that advance computing as a science and a profession. ACM provides the computing field's premier Digital Library and serves its members with leading-edge publications, conferences, and career resources.</p>
            </div>
          </div>
        </div>

        <!-- Card 3: VJIT (Text Left, Card Right) -->
        <div class="scrolling-card scroll-reveal">
          <div class="sticky-card-inner">
            <div class="card-text">
              <p class="sticky-card-desc">Vidya Jyothi Institute of Technology is an autonomous institution, accredited by NBA and NAAC. VJIT is committed to nurturing excellence in engineering education and research, providing students with world-class infrastructure, experienced faculty, and industry-connected programs to prepare them for professional success.</p>
            </div>
            <div class="card-visual">
              <div class="retro-cassette">
                <div class="screw top-left">+</div>
                <div class="screw top-right">+</div>
                <div class="screw bottom-left">+</div>
                <div class="screw bottom-right">+</div>
                
                <div class="cassette-sticker">
                  <div class="sticker-top">
                    <span class="sticker-index">A</span>
                    <span class="sticker-side">SIDE</span>
                  </div>
                  <div class="sticker-title">
                    <span>ABOUT</span>
                    <strong>VJIT</strong>
                  </div>
                  <div class="color-stripes"></div>
                </div>
                
                <div class="cassette-window">
                  <div class="reel reel-left"><div class="reel-hub"></div><div class="reel-teeth"></div></div>
                  <div class="reel reel-right"><div class="reel-hub"></div><div class="reel-teeth"></div></div>
                </div>
                
                <div class="cassette-bottom">
                  <div class="cutout"></div>
                  <div class="cutout-large"></div>
                  <div class="cutout"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Institution Leads Section -->
  <section class="section leads scroll-reveal">
    <div class="container">
      <div class="text-center" style="margin-bottom: 4rem;">
        <h2 class="snippet-title">Institution <span class="text-primary">Leads</span></h2>
        <p class="snippet-desc" style="max-width: 600px; margin-left: auto; margin-right: auto;">Meet the distinguished leadership driving the strategic vision of ACM VJIT.</p>
      </div>
      <div class="leads-grid">
        {
          leadsData.map((lead, index) => {
            const roleParts = lead.role.split(',');
            const primaryRole = roleParts[0];
            const secondaryRole = roleParts.length > 1 ? roleParts[1].trim() : null;
            return (
              <div class={`lead-card delay-${(index % 4) + 1}`}>
                <div class="card-image-wrapper">
                  {lead.photo ? (
                    <img src={lead.photo} alt={lead.name} />
                  ) : (
                    <div class="photo-placeholder">{lead.name.charAt(0)}</div>
                  )}
                </div>
                <div class="card-info">
                  <div class="role-text">
                    <span class="role-primary">{primaryRole}</span>
                    {secondaryRole && <span class="role-secondary"> • {secondaryRole}</span>}
                  </div>
                  <h3 class="lead-name">{lead.name}</h3>
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="text-center" style="margin-top: 3.5rem;">
        <a href="/team" class="btn btn-outline">View Full Team</a>
      </div>
    </div>
  </section>  <!-- Glowing Screen Tab Section -->
  <section class="section glowing-screen-section scroll-reveal">
    <div class="container text-center" style="margin-bottom: 2rem;">
      <h2 class="snippet-title">Get In <span class="text-primary">Touch</span></h2>
      <p class="snippet-desc" style="max-width: 600px; margin-left: auto; margin-right: auto;">Have a question or want to collaborate? Connect with us through our digital portal.</p>
    </div>
    
    
    <div class="ipad-pro-wrapper" id="glowing-contact-tab">
      <div class="ipad-pro-inner">
        <div class="ipad-power-btn" id="ipad-power-btn"></div>
        <div class="ipad-notch">
          <div class="ipad-camera"></div>
        </div>
        <div class="ipad-screen off" id="ipad-screen">
          <!-- Boot Screen Overlay -->
          <div class="ipad-boot-screen" id="ipad-boot-screen">
            <svg class="boot-logo" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 128 128">
              <path fill="#fff" d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" />
            </svg>
            <div class="boot-progress-bar">
              <div class="boot-progress-fill"></div>
            </div>
          </div>
          
          <div class="glowing-tab-wrapper off" id="ipad-main-ui">
      <div class="glowing-tab-border">
        <div class="glowing-tab-content">
          
          <div class="glowing-grid">
            <!-- Left Pane: Info & Map -->
            <div class="glowing-pane info-pane">
              <h3 class="pane-title">Contact Info</h3>
              <p class="pane-intro">Reach out directly or visit our campus branch.</p>
              
              <div class="info-list">
                <div class="info-item">
                  <div class="info-icon-wrapper"><span class="info-icon">✉️</span></div>
                  <div class="info-details">
                    <h5>Email</h5>
                    <p><a href="mailto:acm@vjit.ac.in">acm@vjit.ac.in</a></p>
                  </div>
                </div>
                
                <div class="info-item">
                  <div class="info-icon-wrapper"><span class="info-icon">📱</span></div>
                  <div class="info-details">
                    <h5>Socials</h5>
                    <p>
                      <a href="https://instagram.com" target="_blank">Instagram</a> • 
                      <a href="https://linkedin.com" target="_blank">LinkedIn</a>
                    </p>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon-wrapper"><span class="info-icon">📍</span></div>
                  <div class="info-details">
                    <h5>Address</h5>
                    <p>VJIT, Hyderabad, India</p>
                  </div>
                </div>
              </div>
              
              <div class="tab-map">
                <iframe 
                  src="https://maps.google.com/maps?q=Vidya%20Jyothi%20Institute%20of%20Technology%2C%20Hyderabad&t=&z=14&ie=UTF8&iwloc=&output=embed" 
                  width="100%" 
                  height="140" 
                  style="border:0; border-radius: 12px; filter: grayscale(100%) invert(90%) contrast(1.2);" 
                  allowfullscreen="" 
                  loading="lazy">
                </iframe>
              </div>
            </div>
            
            <!-- Right Pane: Form -->
            <div class="glowing-pane form-pane">
              <h3 class="pane-title">Send Message</h3>
              <form id="contact-tab-form">
                <div class="tab-form-group">
                  <input type="text" id="tab-name" required placeholder="Full Name">
                </div>
                <div class="tab-form-group">
                  <input type="email" id="tab-email" required placeholder="Email Address">
                </div>
                <div class="tab-form-group">
                  <input type="tel" id="tab-phone" required placeholder="Phone Number">
                </div>
                <div class="tab-form-grid-inner">
                  <div class="tab-form-group">
                    <input type="text" id="tab-department" required placeholder="Dept (e.g. AIML)">
                  </div>
                  <div class="tab-form-group">
                    <input type="text" id="tab-year" required placeholder="Year (e.g. 2nd)">
                  </div>
                </div>
                <div class="tab-form-group">
                  <textarea id="tab-message" rows="3" required placeholder="Your message here..."></textarea>
                </div>
                <button type="submit" class="glowing-submit-btn">
                  <span>Send Message</span>
                  <div class="btn-glow"></div>
                </button>
              </form>
            </div>
                    </div>
        </div>
      </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  function initHomeJS() {
    // 1. Intersection Observer for scroll animations
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target); 
        }
      });
    }, observerOptions);

    const revealElements = document.querySelectorAll('.scroll-reveal');
    revealElements.forEach(el => observer.observe(el));

    // 2. Typewriter Effect for Hero Tagline
    const words = [
      "From algorithms to applications.",
      "Where curiosity meets computing.",
      "Learn. Build. Compute.",
      "Turning ideas into working solutions.",
      "Code with purpose.",
      "Computing, powered by community."
    ];
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const typedTextSpan = document.getElementById("typewriter");
    
    if(typedTextSpan) {
      typedTextSpan.textContent = "";

      function typeSubtitle() {
        if(!typedTextSpan) return;
        const currentWord = words[wordIndex];
        if (isDeleting) {
          typedTextSpan.textContent = currentWord.substring(0, charIndex - 1);
          charIndex--;
        } else {
          typedTextSpan.textContent = currentWord.substring(0, charIndex + 1);
          charIndex++;
        }
        
        let typeSpeed = isDeleting ? 20 : 60;
        
        if (!isDeleting && charIndex === currentWord.length) {
          typeSpeed = 2500;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          typeSpeed = 500;
        }
        
        setTimeout(typeSubtitle, typeSpeed);
      }
      setTimeout(typeSubtitle, 1000);
    }
  }

  
  function initIPadBoot() {
    const bootScreen = document.getElementById('ipad-boot-screen');
    const mainUI = document.getElementById('ipad-main-ui');
    const ipadScreen = document.getElementById('ipad-screen');
    const ipadWrapper = document.getElementById('glowing-contact-tab');
    
    let isBooted = false;
    let isBooting = false;

    if (!bootScreen || !ipadWrapper) return;

    function startBoot() {
      if (isBooted || isBooting) return;
      isBooting = true;
      
      // Turn on backlight (allow wallpaper to show later, but keep boot screen black for now)
      ipadScreen.classList.remove('off');
      
      // Start boot sequence
      bootScreen.classList.add('booting');
      
      // After progress bar finishes (2.5s + 0.5s delay)
      setTimeout(() => {
        bootScreen.classList.remove('booting');
        bootScreen.classList.add('hidden');
        
        mainUI.classList.remove('off');
        mainUI.classList.add('on');
        
        isBooted = true;
        isBooting = false;
      }, 3000);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          startBoot();
          observer.disconnect(); // Only boot once
        }
      });
    }, { threshold: 0.3 });

    observer.observe(ipadWrapper);
  }

  function initContactTab() {
    const form = document.getElementById('contact-tab-form');
    if (!form) return;

    // Clone to remove old listeners
    const newForm = form.cloneNode(true);
    if (form.parentNode) {
      form.parentNode.replaceChild(newForm, form);
    }

    newForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const btn = newForm.querySelector('button[type="submit"]');
      if (!btn) return;

      const originalText = btn.querySelector('span').textContent;
      btn.querySelector('span').textContent = 'Sending...';
      btn.disabled = true;
      
      const formData = new FormData();
      formData.append('name', newForm.querySelector('#tab-name').value);
      formData.append('Email', newForm.querySelector('#tab-email').value);
      formData.append('Phone', newForm.querySelector('#tab-phone').value);
      formData.append('Department', newForm.querySelector('#tab-department').value);
      formData.append('Year', newForm.querySelector('#tab-year').value);
      formData.append('Message', newForm.querySelector('#tab-message').value);
      formData.append('Submission Time', new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'long', timeStyle: 'medium' }));
      
      fetch("https://script.google.com/macros/s/AKfycbwgnB-e2j-AaD5rhDmmqvAqrxCMlNE7wkfN6tqAjWJBNOrKBLUyIfYg7v6xMkUawbXQ/exec", {
          method: "POST",
          body: formData
      })
      .then(response => {
          alert("Thank you! Your message has been sent successfully.");
          newForm.reset();
          btn.querySelector('span').textContent = originalText;
          btn.disabled = false;
      })
      .catch(error => {
          console.error(error);
          alert("Oops! Something went wrong.");
          btn.querySelector('span').textContent = originalText;
          btn.disabled = false;
      });
    });
  }

  function runHomeInit() {
    initHomeJS();
    initContactTab();
    initIPadBoot();
  }


  document.addEventListener('DOMContentLoaded', runHomeInit);
  document.addEventListener('astro:page-load', runHomeInit);
</script>

<style>
  /* --- Hero Section (Centered Layout) --- */
  .hero {
    padding: 8rem 0 6rem;
    position: relative;
    overflow: hidden;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: calc(100vh - 80px); /* 80px for header approx */
    justify-content: center;
  }

  .hero-single {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }
  
  .centered-subtitle {
    margin: 0 auto 2rem auto;
    text-align: center;
  }
  
  .centered-actions {
    justify-content: center;
  }

  .hero-title-aesthetic {
    font-size: clamp(4.5rem, 12vw, 9rem);
    font-weight: 400;
    color: #1a1a1a;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem 0;
    opacity: 0;
    transform: translateY(30px);
    animation: cinematicEnter 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.3s;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    background: #ffffff;
    color: #1a1a1a;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 2rem;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    opacity: 0;
    transform: translateY(20px);
    animation: cinematicEnter 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .cursor {
    display: inline-block;
    width: 1px;
    height: 1.2em;
    background-color: #a0aec0;
    margin-left: 4px;
    animation: blink 1s infinite;
    vertical-align: middle;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-subtitle, .hero-actions {
    opacity: 0;
    transform: translateY(30px);
    animation: cinematicEnter 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    margin-bottom: 3rem;
    color: #1a1a1a;
    font-weight: 400;
    animation-delay: 0.5s;
    line-height: 1.8;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    justify-content: flex-start;
    gap: 1.5rem;
    animation-delay: 0.7s;
    flex-wrap: wrap;
  }

  .hero-actions .btn {
    padding: 1rem 2.5rem;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 999px;
    letter-spacing: 0.02em;
    transition: all 0.4s ease;
  }

  .hero-actions .btn-primary {
    background-color: #1a1a1a;
    background-image: none;
    color: #ffffff;
    border: none;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15);
  }
  
  .hero-actions .btn-primary:hover {
    background-color: #333333;
    transform: translateY(-2px);
    box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.2);
  }

  .hero-actions .btn-outline {
    background: transparent;
    border: 1px solid rgba(0,0,0,0.15);
    color: #1a1a1a;
  }
  
  .hero-actions .btn-outline:hover {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: #ffffff !important;
  }

  @keyframes cinematicEnter {
    0% { 
      opacity: 0; 
      transform: translateY(40px); 
      filter: blur(5px); 
    }
    100% { 
      opacity: 1; 
      transform: translateY(0); 
      filter: blur(0px); 
    }
  }

  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .btn-glow {
    position: relative;
    overflow: hidden;
  }
  
  .btn-glow::after {
    content: '';
    position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%;
    background: rgba(255,255,255,0.3);
    transform: rotate(45deg) translate(-50%, -50%);
    animation: button-shine 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes button-shine {
    0% { transform: translateX(-150%) rotate(45deg); }
    30%, 100% { transform: translateX(150%) rotate(45deg); }
  }

  /* --- Scroll Animations Base --- */
  .scroll-reveal > *, .scroll-reveal .feature-card, .scroll-reveal .stat-card, .scroll-reveal .snippet-image, .scroll-reveal .snippet-content, .scroll-reveal .cta-box {
