  .screw.top-left { top: 8px; left: 8px; transform: rotate(45deg); }
  .screw.top-right { top: 8px; right: 8px; transform: rotate(15deg); }
  .screw.bottom-left { bottom: 8px; left: 8px; transform: rotate(70deg); }
  .screw.bottom-right { bottom: 8px; right: 8px; transform: rotate(0deg); }

  /* Sticker */
  .cassette-sticker {
