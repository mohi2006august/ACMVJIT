  .book {
    position: relative;
    height: 500px;
    background: #fdfdfc;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: width 0.75s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.75s ease;
    transform-style: preserve-3d;
    will-change: width, box-shadow;
  }

  /* Gold page corners */
  .gold-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 2px solid rgba(212, 175, 55, 0.35);
    pointer-events: none;
  }
  .gold-corner.top-left { top: 1.25rem; left: 1.25rem; border-right: none; border-bottom: none; }
  .gold-corner.top-right { top: 1.25rem; right: 1.25rem; border-left: none; border-bottom: none; }
  .gold-corner.bottom-left { bottom: 1.25rem; left: 1.25rem; border-right: none; border-top: none; }
  .gold-corner.bottom-right { bottom: 1.25rem; right: 1.25rem; border-left: none; border-top: none; }

  /* Gold cover accents */
  .gold-accent {
    position: absolute;
    font-size: 14px;
    color: rgba(212, 175, 55, 0.5);
    pointer-events: none;
    font-family: monospace;
  }
  .gold-accent.top-left { top: 1.25rem; left: 1.25rem; }
  .gold-accent.top-right { top: 1.25rem; right: 1.25rem; }
  .gold-accent.bottom-left { bottom: 1.25rem; left: 1.25rem; }
  .gold-accent.bottom-right { bottom: 1.25rem; right: 1.25rem; }

  /* Desktop layout states */
  @media (min-width: 769px) {
    .book.closed {
      width: 380px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
    }

    .book.opened {
      width: 760px;
      box-shadow: 0 25px 55px rgba(0, 0, 0, 0.18);
    }

    .book-cover {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 50%;
      transform-origin: left center;
      transition: transform 0.75s cubic-bezier(0.25, 1, 0.5, 1);
      transform-style: preserve-3d;
      z-index: 10;
      will-change: transform;
      cursor: pointer;
    }

    .book.closed .book-cover {
      transform: rotateY(0deg);
    }

    .book.opened .book-cover {
      transform: rotateY(-180deg);
      pointer-events: none;
    }

    .book-page {
      position: absolute;
      top: 0;
