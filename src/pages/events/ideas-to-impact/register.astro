---
import eventsData from '../../../data/events.json';

const event = eventsData.find((e) => e.slug === 'ideas-to-impact')!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Registration &bull; Ideas to Impact 2026 | ACM VJIT</title>
    <meta name="description" content="Official registration form for Ideas to Impact 2026: ThinkScript (Paper Presentation) & VisionBoard (Poster Presentation)." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style define:vars={{
      accentColor: event.accentColor || '#8b5cf6',
      accentColorLight: event.accentColorLight || '#c084fc',
      accentGlow: event.accentGlow || 'rgba(139, 92, 246, 0.35)',
      bgFrom: event.posterBgFrom || '#090714',
      bgTo: event.posterBgTo || '#16092e',
    }}>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--bgFrom);
        color: #f1f5f9;
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        line-height: 1.6;
      }

      /* ── Background & Ambient Lighting ── */
      .page-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background: radial-gradient(circle at 50% 0%, #1e0e3e 0%, var(--bgFrom) 60%, #040308 100%);
        pointer-events: none;
      }

      .bg-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(168, 85, 247, 0.1) 1px, transparent 1px);
        background-size: 32px 32px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 20%, transparent 95%);
      }

      .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        pointer-events: none;
      }
      .glow-orb-1 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.22), transparent 70%);
        top: -100px;
        left: 20%;
      }
      .glow-orb-2 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.15), transparent 70%);
        bottom: 10%;
        right: 15%;
      }

      /* ── Navigation ── */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        background: rgba(9, 7, 20, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(168, 85, 247, 0.15);
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.25s ease;
      }
      .back-link:hover {
        color: #fff;
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.4);
        transform: translateX(-3px);
      }
      .back-link svg {
        width: 16px;
        height: 16px;
      }

      .nav-brand {
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--accentColorLight);
      }

      /* ── Wrapper & Layout ── */
      .form-page-wrapper {
        position: relative;
        z-index: 1;
        min-height: calc(100vh - 65px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 1.5rem 5rem;
      }

      .form-container {
        max-width: 680px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      /* ── Header Form Card ── */
      .form-header-card {
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(168, 85, 247, 0.25);
        border-radius: 20px;
        padding: 2.2rem 2.2rem 1.8rem;
        backdrop-filter: blur(20px);
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.5), 0 0 30px -5px rgba(139, 92, 246, 0.15);
      }
      .form-header-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 6px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6, #ec4899);
      }

      .form-badge-association {
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--accentColorLight);
        margin-bottom: 0.6rem;
        display: inline-block;
      }

      .form-main-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.6rem, 3.5vw, 2.1rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        margin-bottom: 0.4rem;
        letter-spacing: -0.5px;
      }

      .form-subtitle {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 600;
        margin-bottom: 1.4rem;
      }

      .form-intro-callout {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(168, 85, 247, 0.2);
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.85);
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1rem;
      }
      .form-intro-callout strong {
        color: #fff;
      }

      .required-indicator {
        font-size: 0.8rem;
        color: #f87171;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      /* ── Multi-Step Progress Tracker ── */
      .step-tracker {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 16px;
        padding: 0.85rem 1.5rem;
        backdrop-filter: blur(16px);
      }
      .step-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.4);
        transition: color 0.3s ease;
      }
      .step-item.is-active {
        color: var(--accentColorLight);
      }
      .step-item.is-complete {
        color: #10b981;
      }
      .step-bubble {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 800;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
      }
      .step-item.is-active .step-bubble {
        background: var(--accentColor);
        color: #fff;
        border-color: var(--accentColorLight);
        box-shadow: 0 0 12px var(--accentGlow);
      }
      .step-item.is-complete .step-bubble {
        background: #10b981;
        color: #fff;
        border-color: #34d399;
      }
      .step-arrow {
        color: rgba(255, 255, 255, 0.2);
        font-size: 0.8rem;
      }

      /* ── Question Section Cards (Google Form inspired) ── */
      .q-card {
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 1.6rem 1.8rem;
        backdrop-filter: blur(20px);
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        transition: border-color 0.25s ease, background 0.25s ease;
      }
      .q-card:focus-within {
        border-color: rgba(168, 85, 247, 0.4);
        background: rgba(255, 255, 255, 0.05);
      }

      .q-header-banner {
        background: linear-gradient(135deg, #4338ca, #6366f1);
        border-radius: 14px;
        padding: 1rem 1.4rem;
        margin-bottom: 0.5rem;
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .q-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }
      .q-req {
        color: #f87171;
        font-weight: 700;
      }

      /* Inputs */
      .q-input, .q-textarea {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 12px;
        padding: 0.85rem 1.1rem;
        color: #fff;
        font-size: 0.98rem;
        font-family: inherit;
        outline: none;
        transition: all 0.2s ease;
        width: 100%;
      }
      .q-input:focus, .q-textarea:focus {
        border-color: var(--accentColorLight);
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
      }
      .q-textarea {
        resize: vertical;
        min-height: 110px;
        line-height: 1.6;
      }

      /* Radio Group Options */
      .radio-stack {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }
      .radio-tile {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1.1rem;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .radio-tile:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(168, 85, 247, 0.3);
      }
      .radio-tile input[type="radio"] {
        appearance: none;
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        outline: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
      }
      .radio-tile input[type="radio"]:checked {
        border-color: var(--accentColorLight);
        background: var(--accentColor);
        box-shadow: 0 0 8px var(--accentGlow);
      }
      .radio-tile input[type="radio"]:checked::after {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #fff;
      }
      .radio-tile.is-selected {
        background: rgba(139, 92, 246, 0.12);
        border-color: rgba(168, 85, 247, 0.45);
      }
      .radio-text {
        font-size: 0.92rem;
        font-weight: 500;
        color: #e2e8f0;
      }
      .radio-desc {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.5);
        margin-top: 0.15rem;
      }

      /* Checkbox Grid (for Domains) */
      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.65rem;
      }
      .checkbox-tile {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .checkbox-tile:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(168, 85, 247, 0.3);
      }
      .checkbox-tile input[type="checkbox"] {
        appearance: none;
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-radius: 5px;
        outline: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
      }
      .checkbox-tile input[type="checkbox"]:checked {
        border-color: var(--accentColorLight);
        background: var(--accentColor);
      }
      .checkbox-tile input[type="checkbox"]:checked::after {
        content: '✓';
        font-size: 11px;
        color: #fff;
        font-weight: 800;
      }
      .checkbox-tile.is-checked {
        background: rgba(139, 92, 246, 0.12);
        border-color: rgba(168, 85, 247, 0.4);
      }
      .checkbox-label {
        font-size: 0.88rem;
        color: #e2e8f0;
      }

      /* Conditional Team Members Box */
      .team-members-box {
        display: none;
        flex-direction: column;
        gap: 1rem;
        margin-top: 0.5rem;
        padding: 1.25rem;
        border-radius: 14px;
        background: rgba(0, 0, 0, 0.25);
        border: 1px dashed rgba(168, 85, 247, 0.35);
      }
      .team-members-box.is-visible {
        display: flex;
      }
      .team-member-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }

      /* ── Form Navigation Actions ── */
      .form-actions-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.5rem;
      }
      .btn-nav-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 2.2rem;
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 18px var(--accentGlow);
      }
      .btn-nav-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px var(--accentGlow);
        opacity: 0.95;
      }
      .btn-nav-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.6rem;
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.8);
        font-weight: 600;
        font-size: 0.92rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.25s ease;
      }
      .btn-nav-secondary:hover {
        background: rgba(255, 255, 255, 0.09);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.25);
      }

      .btn-clear {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.45);
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s ease;
      }
      .btn-clear:hover {
        color: #f87171;
      }

      /* ── Step Visibility Controls ── */
      .form-step-section {
        display: none;
        flex-direction: column;
        gap: 1.25rem;
        animation: fadeInStep 0.35s ease forwards;
      }
      .form-step-section.is-active {
        display: flex;
      }
      @keyframes fadeInStep {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* ── Step 4: Success Screen ── */
      .success-card {
        display: none;
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(168, 85, 247, 0.3);
        border-radius: 24px;
        padding: 3rem 2.5rem;
        text-align: center;
        backdrop-filter: blur(20px);
        box-shadow: 0 20px 60px -10px rgba(0, 0, 0, 0.7), 0 0 40px -5px rgba(139, 92, 246, 0.25);
        animation: fadeInStep 0.4s ease forwards;
      }
      .success-card.is-visible {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .success-badge-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.15);
        border: 2px solid #10b981;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 0 30px rgba(16, 185, 129, 0.3);
      }
      .success-main-headline {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 0.6rem;
      }
      .success-sub {
        font-size: 0.98rem;
        color: rgba(255, 255, 255, 0.7);
        max-width: 500px;
        line-height: 1.7;
        margin-bottom: 2rem;
      }
      .ticket-summary-box {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.5rem;
        width: 100%;
        max-width: 480px;
        text-align: left;
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.88rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 0.5rem;
      }
      .summary-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
      .summary-key {
        color: rgba(255, 255, 255, 0.5);
      }
      .summary-val {
        color: #fff;
        font-weight: 700;
      }

      /* ── Responsive ── */
      @media (max-width: 640px) {
        .form-page-wrapper {
          padding: 1.5rem 1rem 4rem;
        }
        .form-header-card {
          padding: 1.6rem 1.4rem;
        }
        .q-card {
          padding: 1.3rem 1.2rem;
        }
        .step-tracker {
          padding: 0.75rem 1rem;
        }
        .step-label {
          display: none;
        }
        .checkbox-grid {
          grid-template-columns: 1fr;
        }
        .team-member-row {
          grid-template-columns: 1fr;
        }
        .top-nav {
          padding: 0.85rem 1rem;
        }
      }
    </style>
  </head>

  <body>
    <!-- Background Decor -->
    <div class="page-bg">
      <div class="bg-grid"></div>
      <div class="glow-orb glow-orb-1"></div>
      <div class="glow-orb glow-orb-2"></div>
    </div>

    <!-- Navigation Header -->
    <header class="top-nav">
      <a href="/events/ideas-to-impact" class="back-link" id="nav-back-to-event">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to Event Details
      </a>
      <span class="nav-brand">ACM VJIT &bull; Registration</span>
    </header>

    <main class="form-page-wrapper">
      <div class="form-container">

        <!-- Top Header Card -->
        <div class="form-header-card">
          <span class="form-badge-association">Department of CSE (AI &amp; ML) &bull; ACM VJIT &bull; IIC-VJIT</span>
          <h1 class="form-main-title">Ideas to Impact 2026 &mdash; Student Research Showcase</h1>
          <p class="form-subtitle">Official Registration Form &bull; ThinkScript &amp; VisionBoard</p>

          <div class="form-intro-callout">
            <p>&bull; You can participate <strong>solo</strong> (or) form a team <strong>upto 4 members</strong>.</p>
            <p>&bull; Showcase your ideas, research, creativity, and innovation through <strong>ThinkScript &mdash; Paper Presentation</strong> or <strong>VisionBoard &mdash; Poster Presentation</strong>.</p>
            <p>&bull; Please fill in the details carefully. Selected participants will receive further instructions through the official communication channel.</p>
          </div>

          <div class="required-indicator">
            <span>* Indicates required question</span>
          </div>
        </div>

        <!-- Multi-Step Indicator -->
        <div class="step-tracker" id="step-tracker">
          <div class="step-item is-active" id="step-tab-1">
            <div class="step-bubble">1</div>
            <span class="step-label">Participant Info</span>
          </div>
          <span class="step-arrow">&rarr;</span>
          <div class="step-item" id="step-tab-2">
            <div class="step-bubble">2</div>
            <span class="step-label">Category Selection</span>
          </div>
          <span class="step-arrow">&rarr;</span>
          <div class="step-item" id="step-tab-3">
            <div class="step-bubble">3</div>
            <span class="step-label">Track Submission</span>
          </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STEP 1: PARTICIPANT INFORMATION -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <section class="form-step-section is-active" id="step-section-1">
          <!-- 1. Full Name -->
          <div class="q-card">
            <label class="q-label" for="field-name">
              Full Name <span class="q-req">*</span>
            </label>
            <input type="text" id="field-name" class="q-input" placeholder="e.g. MOHAMMED MOHIUDDIN" required />
          </div>

          <!-- 2. Roll Number -->
          <div class="q-card">
            <label class="q-label" for="field-roll">
              Roll Number <span class="q-req">*</span>
            </label>
            <input type="text" id="field-roll" class="q-input" placeholder="e.g. 25911A66G7" required />
          </div>

          <!-- 3. Year of Study -->
          <div class="q-card">
            <label class="q-label">
              Year of Study <span class="q-req">*</span>
            </label>
            <div class="radio-stack">
              <label class="radio-tile" onclick="selectRadio(this, 'field-year')">
                <input type="radio" name="field-year" value="2nd Year" required />
                <span class="radio-text">2nd Year</span>
              </label>
              <label class="radio-tile" onclick="selectRadio(this, 'field-year')">
                <input type="radio" name="field-year" value="3rd Year" />
                <span class="radio-text">3rd Year</span>
              </label>
              <label class="radio-tile" onclick="selectRadio(this, 'field-year')">
                <input type="radio" name="field-year" value="4th Year" />
                <span class="radio-text">4th Year</span>
              </label>
            </div>
          </div>

          <!-- 4. Section -->
          <div class="q-card">
            <label class="q-label">
              Section <span class="q-req">*</span>
            </label>
            <div class="radio-stack">
              <label class="radio-tile" onclick="selectRadio(this, 'field-section')">
                <input type="radio" name="field-section" value="A" required />
                <span class="radio-text">Section A</span>
              </label>
              <label class="radio-tile" onclick="selectRadio(this, 'field-section')">
                <input type="radio" name="field-section" value="B" />
                <span class="radio-text">Section B</span>
              </label>
              <label class="radio-tile" onclick="selectRadio(this, 'field-section')">
                <input type="radio" name="field-section" value="C" />
                <span class="radio-text">Section C</span>
              </label>
            </div>
          </div>

          <!-- 5. Email Address -->
          <div class="q-card">
            <label class="q-label" for="field-email">
              Email Address <span class="q-req">*</span>
            </label>
            <input type="email" id="field-email" class="q-input" placeholder="e.g. nizamuddinnumaan822@gmail.com" required />
          </div>

          <!-- 6. Mobile Number -->
          <div class="q-card">
            <label class="q-label" for="field-phone">
              Mobile Number <span class="q-req">*</span>
            </label>
            <input type="tel" id="field-phone" class="q-input" placeholder="e.g. 8074422913" required />
          </div>

          <!-- 7. Participation Type -->
          <div class="q-card">
            <label class="q-label">
              Participation Type <span class="q-req">*</span>
            </label>
            <div class="radio-stack">
              <label class="radio-tile is-selected" onclick="toggleParticipation(this, 'Individual')">
                <input type="radio" name="field-participation" value="Individual" checked />
                <div>
                  <div class="radio-text">Individual</div>
                  <div class="radio-desc">Participate as a solo participant</div>
                </div>
              </label>
              <label class="radio-tile" onclick="toggleParticipation(this, 'Team')">
                <input type="radio" name="field-participation" value="Team" />
                <div>
                  <div class="radio-text">Team</div>
                  <div class="radio-desc">Form a team of up to 4 members</div>
                </div>
              </label>
            </div>

            <!-- Conditional Team Section -->
            <div class="team-members-box" id="team-details-box">
              <div class="q-label" style="font-size:0.85rem; color:var(--accentColorLight);">
                Team Details (Up to 4 members)
              </div>
              <input type="text" id="field-team-name" class="q-input" placeholder="Team Name (e.g. Neural Pioneers)" />
              
              <div class="team-member-row">
                <input type="text" id="member2-name" class="q-input" placeholder="Member 2 Name" />
                <input type="text" id="member2-roll" class="q-input" placeholder="Member 2 Roll No" />
              </div>
              <div class="team-member-row">
                <input type="text" id="member3-name" class="q-input" placeholder="Member 3 Name (Optional)" />
                <input type="text" id="member3-roll" class="q-input" placeholder="Member 3 Roll No" />
              </div>
              <div class="team-member-row">
                <input type="text" id="member4-name" class="q-input" placeholder="Member 4 Name (Optional)" />
                <input type="text" id="member4-roll" class="q-input" placeholder="Member 4 Roll No" />
              </div>
            </div>
          </div>

          <!-- Actions Bar Step 1 -->
          <div class="form-actions-bar">
            <button type="button" class="btn-clear" onclick="resetForm()">Clear form</button>
            <button type="button" class="btn-nav-primary" onclick="goToStep(2)">
              Next &rarr;
            </button>
          </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STEP 2: PRESENTATION DETAILS -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <section class="form-step-section" id="step-section-2">
          <div class="q-header-banner">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:20px;height:20px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
            </svg>
            Presentation Details
          </div>

          <div class="q-card">
            <label class="q-label">
              Choose Your Presentation Category <span class="q-req">*</span>
            </label>
            <div class="radio-stack">
              <label class="radio-tile is-selected" onclick="selectCategoryRadio(this, 'ThinkScript – Paper Presentation')">
                <input type="radio" name="field-category" value="ThinkScript – Paper Presentation" checked />
                <div>
                  <div class="radio-text">📝 ThinkScript &mdash; Paper Presentation</div>
                  <div class="radio-desc">Research paper presentation, algorithmic solutions, and technical insights.</div>
                </div>
              </label>

              <label class="radio-tile" onclick="selectCategoryRadio(this, 'VisionBoard – Poster Presentation')">
                <input type="radio" name="field-category" value="VisionBoard – Poster Presentation" />
                <div>
                  <div class="radio-text">🎨 VisionBoard &mdash; Poster Presentation</div>
                  <div class="radio-desc">Visual design exhibition, creative architectures, and prototype displays.</div>
                </div>
              </label>
            </div>
          </div>

          <!-- Actions Bar Step 2 -->
          <div class="form-actions-bar">
            <button type="button" class="btn-nav-secondary" onclick="goToStep(1)">
              &larr; Back
            </button>
            <button type="button" class="btn-nav-primary" onclick="goToStep(3)">
              Next &rarr;
            </button>
          </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STEP 3: TRACK SUBMISSION (ThinkScript / VisionBoard) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <section class="form-step-section" id="step-section-3">
          <!-- Dynamic Category Banner -->
          <div class="q-header-banner" id="step3-banner">
            ThinkScript &mdash; Paper Presentation
          </div>

          <!-- Title Input -->
          <div class="q-card">
            <label class="q-label" for="field-title" id="title-label">
              Paper / Research Title <span class="q-req">*</span>
            </label>
            <input type="text" id="field-title" class="q-input" placeholder="Your answer" required />
          </div>

          <!-- Abstract Input -->
          <div class="q-card">
            <label class="q-label" for="field-abstract" id="abstract-label">
              Abstract <span class="q-req">*</span>
            </label>
            <textarea id="field-abstract" class="q-textarea" placeholder="Provide a brief summary of your work / abstract (minimum 50 words)..." required></textarea>
          </div>

          <!-- Research Domain (Multi-Checkboxes from screenshot) -->
          <div class="q-card">
            <label class="q-label">
              Research Domain <span class="q-req">*</span>
            </label>
            <div class="checkbox-grid">
              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Artificial Intelligence" />
                <span class="checkbox-label">Artificial Intelligence</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Machine Learning" />
                <span class="checkbox-label">Machine Learning</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Data Science" />
                <span class="checkbox-label">Data Science</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Web Development" />
                <span class="checkbox-label">Web Development</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Cyber Security" />
                <span class="checkbox-label">Cyber Security</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="IoT" />
                <span class="checkbox-label">IoT (Internet of Things)</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Robotics" />
                <span class="checkbox-label">Robotics</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Cloud Computing" />
                <span class="checkbox-label">Cloud Computing</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Blockchain" />
                <span class="checkbox-label">Blockchain</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="Computer Vision" />
                <span class="checkbox-label">Computer Vision</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)">
                <input type="checkbox" name="field-domains" value="NLP" />
                <span class="checkbox-label">NLP (Natural Language Processing)</span>
              </label>

              <label class="checkbox-tile" onclick="toggleCheckbox(this)" id="other-checkbox-tile">
                <input type="checkbox" name="field-domains" value="Other" id="other-checkbox" onchange="toggleOtherInput(this)" />
                <span class="checkbox-label">Other:</span>
              </label>
            </div>

            <!-- Other custom input -->
            <input type="text" id="field-domain-other" class="q-input" style="display:none; margin-top:0.75rem;" placeholder="Please specify your research domain..." />
          </div>

          <!-- Actions Bar Step 3 -->
          <div class="form-actions-bar">
            <button type="button" class="btn-nav-secondary" onclick="goToStep(2)">
              &larr; Back
            </button>
            <button type="button" class="btn-nav-primary" id="btn-submit" onclick="submitFinalRegistration()">
              Submit Registration
            </button>
          </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STEP 4: SUCCESS CONFIRMATION -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <div class="success-card" id="success-screen">
          <div class="success-badge-icon">🎉</div>
          <h2 class="success-main-headline">Registration Submitted!</h2>
          <p class="success-sub">
            Your registration for <strong>Ideas to Impact 2026</strong> has been officially recorded. Selected participants will receive further details, schedule, and guidelines through official channels.
          </p>

          <div class="ticket-summary-box">
            <div class="summary-row">
              <span class="summary-key">Registration ID:</span>
              <span class="summary-val" id="res-reg-id">ITI-2026-8492</span>
            </div>
            <div class="summary-row">
              <span class="summary-key">Participant Name:</span>
              <span class="summary-val" id="res-name">-</span>
            </div>
            <div class="summary-row">
              <span class="summary-key">Roll Number:</span>
              <span class="summary-val" id="res-roll">-</span>
            </div>
            <div class="summary-row">
              <span class="summary-key">Category:</span>
              <span class="summary-val" id="res-category">-</span>
            </div>
            <div class="summary-row">
              <span class="summary-key">Topic / Title:</span>
              <span class="summary-val" id="res-title">-</span>
            </div>
            <div class="summary-row">
              <span class="summary-key">Selected Domains:</span>
              <span class="summary-val" id="res-domains">-</span>
            </div>
          </div>

          <div style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;">
            <a href="/events/ideas-to-impact" class="btn-nav-primary">
              &larr; Back to Event Page
            </a>
            <a href="/events" class="btn-nav-secondary">
              View All Events
            </a>
          </div>
        </div>

      </div>
    </main>

    <!-- Client-side Interactive Navigation & State Script -->
    <script is:inline>
      let currentStep = 1;
      let selectedCategory = 'ThinkScript – Paper Presentation';

      function selectRadio(element, radioName) {
        const radios = document.querySelectorAll(`input[name="${radioName}"]`);
        radios.forEach(r => {
          const tile = r.closest('.radio-tile');
          if (tile) tile.classList.remove('is-selected');
        });
        const radio = element.querySelector('input[type="radio"]');
        if (radio) {
          radio.checked = true;
          element.classList.add('is-selected');
        }
      }

      function toggleParticipation(element, type) {
        selectRadio(element, 'field-participation');
        const teamBox = document.getElementById('team-details-box');
        if (teamBox) {
          if (type === 'Team') {
            teamBox.classList.add('is-visible');
          } else {
            teamBox.classList.remove('is-visible');
          }
        }
      }

      function selectCategoryRadio(element, categoryName) {
        selectRadio(element, 'field-category');
        selectedCategory = categoryName;
        updateStep3Labels();
      }

      function updateStep3Labels() {
        const banner = document.getElementById('step3-banner');
        const titleLabel = document.getElementById('title-label');
        const abstractLabel = document.getElementById('abstract-label');

        if (selectedCategory.includes('ThinkScript')) {
          if (banner) banner.textContent = 'ThinkScript — Paper Presentation';
          if (titleLabel) titleLabel.innerHTML = 'Paper / Research Title <span class="q-req">*</span>';
          if (abstractLabel) abstractLabel.innerHTML = 'Abstract <span class="q-req">*</span>';
        } else {
          if (banner) banner.textContent = 'VisionBoard — Poster Presentation';
          if (titleLabel) titleLabel.innerHTML = 'Poster / Project Title <span class="q-req">*</span>';
          if (abstractLabel) abstractLabel.innerHTML = 'Concept / Theme Overview <span class="q-req">*</span>';
        }
      }

      function toggleCheckbox(element) {
        const cb = element.querySelector('input[type="checkbox"]');
        if (cb) {
          // If clicked directly on the tile, toggle (unless click was on input itself)
          if (event && event.target !== cb) {
            cb.checked = !cb.checked;
          }
          if (cb.checked) {
            element.classList.add('is-checked');
          } else {
            element.classList.remove('is-checked');
          }
        }
      }

      function toggleOtherInput(cb) {
        const otherInput = document.getElementById('field-domain-other');
        if (otherInput) {
          otherInput.style.display = cb.checked ? 'block' : 'none';
          if (cb.checked) otherInput.focus();
        }
      }

      function validateStep(step) {
        if (step === 1) {
          const name = document.getElementById('field-name').value.trim();
          const roll = document.getElementById('field-roll').value.trim();
          const year = document.querySelector('input[name="field-year"]:checked');
          const section = document.querySelector('input[name="field-section"]:checked');
          const email = document.getElementById('field-email').value.trim();
          const phone = document.getElementById('field-phone').value.trim();

          if (!name) {
            alert('Please enter your Full Name.');
            document.getElementById('field-name').focus();
            return false;
          }
          if (!roll) {
            alert('Please enter your Roll Number.');
            document.getElementById('field-roll').focus();
            return false;
          }
          if (!year) {
            alert('Please select your Year of Study.');
            return false;
          }
          if (!section) {
            alert('Please select your Section.');
            return false;
          }
          if (!email || !email.includes('@')) {
            alert('Please enter a valid Email Address.');
            document.getElementById('field-email').focus();
            return false;
          }
          if (!phone || phone.length < 10) {
            alert('Please enter a valid 10-digit Mobile Number.');
            document.getElementById('field-phone').focus();
            return false;
          }
          return true;
        }

        if (step === 2) {
          const category = document.querySelector('input[name="field-category"]:checked');
          if (!category) {
            alert('Please choose a presentation category.');
            return false;
          }
          selectedCategory = category.value;
          updateStep3Labels();
          return true;
        }

        return true;
      }

      function goToStep(step) {
        if (step > currentStep) {
          if (!validateStep(currentStep)) return;
        }

        currentStep = step;

        // Hide all step sections
        for (let i = 1; i <= 3; i++) {
          const sec = document.getElementById(`step-section-${i}`);
          const tab = document.getElementById(`step-tab-${i}`);
          if (sec) sec.classList.remove('is-active');
          if (tab) {
            tab.classList.remove('is-active', 'is-complete');
            if (i < currentStep) tab.classList.add('is-complete');
            if (i === currentStep) tab.classList.add('is-active');
          }
        }

        const targetSec = document.getElementById(`step-section-${step}`);
        if (targetSec) targetSec.classList.add('is-active');

        window.scrollTo({ top: 180, behavior: 'smooth' });
      }

      function submitFinalRegistration() {
        const title = document.getElementById('field-title').value.trim();
        const abstract = document.getElementById('field-abstract').value.trim();
        const checkedDomains = Array.from(document.querySelectorAll('input[name="field-domains"]:checked')).map(cb => {
          if (cb.value === 'Other') {
            const otherVal = document.getElementById('field-domain-other').value.trim();
            return otherVal ? `Other (${otherVal})` : 'Other';
          }
          return cb.value;
        });

        if (!title) {
          alert('Please enter your Paper / Project Title.');
          document.getElementById('field-title').focus();
          return;
        }
        if (!abstract) {
          alert('Please enter your Abstract / Concept Overview.');
          document.getElementById('field-abstract').focus();
          return;
        }
        if (checkedDomains.length === 0) {
          alert('Please select at least one Research Domain.');
          return;
        }

        const submitBtn = document.getElementById('btn-submit');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting Registration...';
        }

        setTimeout(() => {
          // Generate Registration ID
          const regId = 'ITI-2026-' + Math.floor(1000 + Math.random() * 9000);
          const name = document.getElementById('field-name').value.trim();
          const roll = document.getElementById('field-roll').value.trim();

          // Populate success screen
          document.getElementById('res-reg-id').textContent = regId;
          document.getElementById('res-name').textContent = name;
          document.getElementById('res-roll').textContent = roll;
          document.getElementById('res-category').textContent = selectedCategory;
          document.getElementById('res-title').textContent = title;
          document.getElementById('res-domains').textContent = checkedDomains.slice(0, 3).join(', ') + (checkedDomains.length > 3 ? ` +${checkedDomains.length - 3} more` : '');

          // Hide form steps and show success card
          document.getElementById('step-section-1').style.display = 'none';
          document.getElementById('step-section-2').style.display = 'none';
          document.getElementById('step-section-3').style.display = 'none';
          document.getElementById('step-tracker').style.display = 'none';

          const successScreen = document.getElementById('success-screen');
          if (successScreen) successScreen.classList.add('is-visible');

          // Save to local storage
          try {
            const existing = JSON.parse(localStorage.getItem('acm_ideas_to_impact_registrations') || '[]');
            existing.push({
              regId,
              name,
              roll,
              category: selectedCategory,
              title,
              domains: checkedDomains,
              timestamp: new Date().toISOString()
            });
            localStorage.setItem('acm_ideas_to_impact_registrations', JSON.stringify(existing));
          } catch (e) {}

          window.scrollTo({ top: 120, behavior: 'smooth' });
        }, 600);
      }

      function resetForm() {
        if (confirm('Are you sure you want to clear the form?')) {
          document.querySelectorAll('.q-input, .q-textarea').forEach(input => input.value = '');
          document.querySelectorAll('.radio-tile').forEach(tile => tile.classList.remove('is-selected'));
          document.querySelectorAll('.checkbox-tile').forEach(tile => tile.classList.remove('is-checked'));
          document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        }
      }
    </script>
  </body>
</html>
