---
import eventsData from '../../../data/events.json';

const event = eventsData.find((e) => e.slug === '3d-website-workshop-2026')!;
const isUpcoming = event.status === 'upcoming' || event.status === 'live';

const tools = [
  { name: 'Google Flow', icon: '🌊', desc: '3D Design & Animation', color: '#8b5cf6' },
  { name: 'Google Antigravity', icon: '🚀', desc: 'AI Coding Assistant', color: '#06b6d4' },
  { name: 'Google Stitch', icon: '🧵', desc: 'Component Stitching', color: '#f59e0b' },
  { name: 'UI Libraries', icon: '📦', desc: 'Premium Components', color: '#ec4899' },
  { name: 'GitHub', icon: '🐙', desc: 'Version Control', color: '#6366f1' },
  { name: 'Vercel', icon: '▲', desc: 'Deploy & Host', color: '#10b981' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{event.title} | ACM VJIT Workshop</title>
    <meta name="description" content={event.shortDesc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
      /* ═══════════════════════════════════════
         CSS Custom Properties
      ═══════════════════════════════════════ */
      :root {
        --accent: #8b5cf6;
        --accent-light: #c084fc;
        --accent-glow: rgba(139, 92, 246, 0.3);
        --cyan: #06b6d4;
        --pink: #ec4899;
        --gold: #f59e0b;
        --bg-deep: #050510;
        --bg-mid: #0a0520;
        --surface: rgba(255, 255, 255, 0.03);
        --surface-hover: rgba(255, 255, 255, 0.07);
        --border: rgba(255, 255, 255, 0.06);
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.6);
        --text-muted: rgba(255, 255, 255, 0.35);
      }

      /* ═══════════════════════════════════════
         Reset & Base
      ═══════════════════════════════════════ */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      body {
        font-family: 'Inter', -apple-system, sans-serif;
        background: var(--bg-deep);
        color: var(--text-primary);
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* ═══════════════════════════════════════
         Three.js Canvas
      ═══════════════════════════════════════ */
      #three-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
      }

      /* ═══════════════════════════════════════
         Background Effects
      ═══════════════════════════════════════ */
      .bg-gradient {
        position: fixed;
        inset: 0;
        z-index: 0;
        background:
          radial-gradient(ellipse 80% 60% at 50% 0%, rgba(139, 92, 246, 0.12) 0%, transparent 60%),
          radial-gradient(ellipse 60% 50% at 80% 50%, rgba(6, 182, 212, 0.06) 0%, transparent 50%),
          radial-gradient(ellipse 50% 40% at 20% 80%, rgba(236, 72, 153, 0.05) 0%, transparent 50%),
          linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-mid) 100%);
        pointer-events: none;
      }

      .bg-noise {
        position: fixed;
        inset: 0;
        z-index: 0;
        opacity: 0.015;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        pointer-events: none;
      }

      .bg-grid {
        position: fixed;
        inset: 0;
        z-index: 0;
        background-image:
          linear-gradient(rgba(139, 92, 246, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(139, 92, 246, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 20%, transparent 80%);
        pointer-events: none;
      }

      /* ═══════════════════════════════════════
         Page Wrapper
      ═══════════════════════════════════════ */
      .page-wrapper {
        position: relative;
        z-index: 1;
        min-height: 100vh;
      }

      /* ═══════════════════════════════════════
         Top Nav
      ═══════════════════════════════════════ */
      .top-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 2rem;
        backdrop-filter: blur(20px) saturate(180%);
        background: rgba(5, 5, 16, 0.6);
        border-bottom: 1px solid var(--border);
        transition: all 0.3s ease;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        padding: 0.45rem 1rem;
        border-radius: 99px;
        border: 1px solid var(--border);
      }
      .back-link:hover {
        color: #fff;
        background: var(--surface-hover);
        border-color: rgba(255,255,255,0.15);
        transform: translateX(-3px);
      }
      .back-link svg { width: 16px; height: 16px; }

      .nav-brand {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 3px;
        text-transform: uppercase;
      }

      .nav-register-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.25rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        border-radius: 99px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 16px var(--accent-glow);
      }
      .nav-register-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px var(--accent-glow);
      }

      /* ═══════════════════════════════════════
         Hero Section
      ═══════════════════════════════════════ */
      .hero {
        padding: 10rem 2rem 6rem;
        max-width: 1100px;
        margin: 0 auto;
        text-align: center;
        position: relative;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 1.25rem;
        border-radius: 99px;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent-light);
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.25);
        margin-bottom: 2rem;
        animation: hero-badge-in 0.8s cubic-bezier(0.16,1,0.3,1) forwards;
        opacity: 0;
      }
      .hero-badge .dot {
        width: 6px; height: 6px;
        background: var(--accent-light);
        border-radius: 50%;
        animation: pulse-dot 2s ease-in-out infinite;
      }

      @keyframes hero-badge-in {
        from { opacity: 0; transform: translateY(-15px) scale(0.95); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
      }

      .hero-price {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(4rem, 12vw, 8rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -4px;
        margin-bottom: 0.5rem;
        animation: hero-price-in 0.9s cubic-bezier(0.16,1,0.3,1) 0.1s forwards;
        opacity: 0;
        background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.75) 50%, var(--accent-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 10px 20px rgba(0,0,0,0.8));
      }

      @keyframes hero-price-in {
        from { opacity: 0; transform: translateY(40px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .hero-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.8rem, 5vw, 3.2rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -1.5px;
        color: #fff;
        margin-bottom: 1.5rem;
        text-shadow: 0 4px 20px rgba(0,0,0,0.8);
        perspective: 1000px;
        transition: transform 0.1s ease-out;
      }
      
      .hero-title .word {
        display: inline-block;
        opacity: 0;
        transform: translateY(24px) translateZ(0);
        filter: blur(8px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                    filter 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      .hero-title .word.reveal-in {
        opacity: 1;
        transform: translateY(0) translateZ(0);
        filter: blur(0);
      }

      .hero-title .gradient-text {
        background: linear-gradient(120deg, var(--accent-light) 0%, var(--cyan) 50%, var(--accent-light) 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: textShimmer 4s linear infinite;
        display: inline-block;
      }

      @keyframes textShimmer {
        0% { background-position: 0% center; }
        100% { background-position: 200% center; }
      }

      .hero-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto 2.5rem;
        line-height: 1.8;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s, 
                    transform 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s;
      }
      
      .hero-subtitle.reveal-in {
        opacity: 1;
        transform: translateY(0);
      }

      @keyframes fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .hero-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 3rem;
        animation: fade-up 0.8s ease 0.45s forwards;
        opacity: 0;
      }
      .hero-meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        font-size: 0.92rem;
        font-weight: 500;
      }
      .hero-meta-item svg { width: 16px; height: 16px; opacity: 0.6; }
      .hero-meta-item .meta-accent {
        color: var(--accent-light);
        font-weight: 700;
      }

      .hero-cta-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        animation: fade-up 0.8s ease 0.55s forwards;
        opacity: 0;
      }

      .cta-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 1.1rem 2.5rem;
        background: linear-gradient(135deg, var(--accent), #a855f7, var(--cyan));
        background-size: 200% 200%;
        animation: gradient-shift 4s ease infinite;
        color: #fff;
        font-weight: 800;
        font-size: 1.05rem;
        border-radius: 16px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 40px var(--accent-glow), 0 0 0 1px rgba(139, 92, 246, 0.3);
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
      }
      .cta-primary::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, transparent 30%, rgba(255,255,255,0.15) 50%, transparent 70%);
        transform: translateX(-100%);
        transition: transform 0.6s ease;
      }
      .cta-primary:hover::before {
        transform: translateX(100%);
      }
      .cta-primary:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 20px 60px var(--accent-glow), 0 0 0 1px rgba(139, 92, 246, 0.5);
      }
      .cta-primary svg { width: 18px; height: 18px; }

      @keyframes gradient-shift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      .cta-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1.1rem 2rem;
        background: var(--surface);
        color: var(--text-secondary);
        font-weight: 700;
        font-size: 1rem;
        border-radius: 16px;
        text-decoration: none;
        border: 1px solid var(--border);
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .cta-secondary:hover {
        color: #fff;
        background: var(--surface-hover);
        border-color: rgba(255,255,255,0.15);
        transform: translateY(-2px);
      }
      .cta-secondary svg { width: 16px; height: 16px; }

      /* ═══════════════════════════════════════
         Floating 3D Badge
      ═══════════════════════════════════════ */
      .floating-badge {
        position: absolute;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 0.75rem 1.25rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--text-secondary);
        animation: float 6s ease-in-out infinite;
        pointer-events: none;
        white-space: nowrap;
      }
      .floating-badge .badge-emoji { font-size: 1.2rem; margin-right: 0.4rem; }
      .fb-1 { top: 25%; left: -2%; animation-delay: 0s; }
      .fb-2 { top: 20%; right: -2%; animation-delay: -2s; }
      .fb-3 { bottom: 10%; left: 5%; animation-delay: -4s; }
      .fb-4 { bottom: 15%; right: 5%; animation-delay: -1s; }

      @keyframes float {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        25% { transform: translateY(-12px) rotate(1deg); }
        75% { transform: translateY(8px) rotate(-1deg); }
      }

      /* ═══════════════════════════════════════
         Stats Bar
      ═══════════════════════════════════════ */
      .stats-bar {
        max-width: 800px;
        margin: 0 auto 6rem;
        padding: 0 2rem;
        animation: fade-up 0.8s ease 0.65s forwards;
        opacity: 0;
      }
      .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--border);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--border);
      }
      .stat-cell {
        background: rgba(10, 5, 32, 0.8);
        backdrop-filter: blur(10px);
        padding: 2rem 1.5rem;
        text-align: center;
        transition: background 0.3s ease;
      }
      .stat-cell:hover { background: var(--surface-hover); }
      .stat-value {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent-light);
        line-height: 1;
        margin-bottom: 0.4rem;
      }
      .stat-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1.5px;
      }

      /* ═══════════════════════════════════════
         Section Headers
      ═══════════════════════════════════════ */
      .section {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 2rem 6rem;
      }

      .section-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 1rem;
      }
      .section-label::before {
        content: '';
        width: 20px;
        height: 1px;
        background: var(--accent);
      }

      .section-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 700;
        letter-spacing: -1.5px;
        line-height: 1.15;
        color: #fff;
        margin-bottom: 3rem;
      }
      .section-title .highlight {
        background: linear-gradient(135deg, var(--accent-light), var(--cyan));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* ═══════════════════════════════════════
         Tools Grid
      ═══════════════════════════════════════ */
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }

      .tool-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 2rem 1.75rem;
        transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
        cursor: default;
        overflow: hidden;
        transform-style: preserve-3d;
        perspective: 800px;
      }
      .tool-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--tool-color, var(--accent));
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .tool-card:hover::before { opacity: 1; }
      .tool-card:hover {
        background: var(--surface-hover);
        border-color: rgba(255,255,255,0.12);
        transform: translateY(-8px) rotateX(2deg);
        box-shadow: 0 20px 60px rgba(0,0,0,0.3), 0 0 40px rgba(139, 92, 246, 0.06);
      }

      .tool-icon {
        font-size: 2.2rem;
        margin-bottom: 1.25rem;
        display: block;
        transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
      }
      .tool-card:hover .tool-icon { transform: scale(1.15) translateY(-3px); }

      .tool-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.35rem;
      }
      .tool-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 500;
      }

      /* ═══════════════════════════════════════
         About Section
      ═══════════════════════════════════════ */
      .about-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 3rem;
        position: relative;
        overflow: hidden;
      }
      .about-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.08), transparent 70%);
        pointer-events: none;
      }

      .about-text {
        color: var(--text-secondary);
        font-size: 1.05rem;
        line-height: 1.9;
        white-space: pre-line;
        position: relative;
        z-index: 1;
      }

      /* ═══════════════════════════════════════
         Workshop Agenda
      ═══════════════════════════════════════ */
      .agenda-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .agenda-item {
        display: flex;
        gap: 1.5rem;
        padding: 1.75rem 2rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
        align-items: flex-start;
      }
      .agenda-item:hover {
        background: var(--surface-hover);
        border-color: rgba(255,255,255,0.1);
        transform: translateX(8px);
      }
      .agenda-step {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent);
        opacity: 0.4;
        line-height: 1;
        min-width: 40px;
      }
      .agenda-content h4 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.35rem;
      }
      .agenda-content p {
        font-size: 0.92rem;
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* ═══════════════════════════════════════
         Registration Section
      ═══════════════════════════════════════ */
      .register-section {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 2rem 8rem;
      }

      .register-card {
        position: relative;
        border-radius: 28px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), rgba(6, 182, 212, 0.05));
        border: 1px solid rgba(139, 92, 246, 0.15);
        padding: 4rem;
      }
      .register-card::before {
        content: '';
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        background: linear-gradient(135deg, var(--accent), var(--cyan), var(--pink), var(--accent));
        background-size: 300% 300%;
        border-radius: 30px;
        z-index: -1;
        animation: gradient-border 6s ease infinite;
        opacity: 0.3;
      }

      @keyframes gradient-border {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      .register-card-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
      }

      .register-info h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: -1px;
        color: #fff;
        margin-bottom: 1rem;
        line-height: 1.15;
      }
      .register-info p {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 2rem;
      }
      .register-perks {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .perk-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--text-secondary);
        font-size: 0.92rem;
        font-weight: 500;
      }
      .perk-icon {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(139, 92, 246, 0.15);
        border-radius: 8px;
        font-size: 0.85rem;
      }

      /* Registration Form */
      .register-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }
      .form-field label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
      }
      .form-field input {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        border-radius: 12px;
        color: #fff;
        font-size: 0.95rem;
        padding: 0.85rem 1rem;
        font-weight: 500;
        outline: none;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
      }
      .form-field input::placeholder { color: rgba(255,255,255,0.2); }
      .form-field input:focus {
        border-color: var(--accent);
        background: rgba(139, 92, 246, 0.05);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
      }

      .submit-btn {
        margin-top: 0.5rem;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, var(--accent), var(--accent-light));
        color: #fff;
        font-weight: 800;
        font-size: 1rem;
        border-radius: 14px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 24px var(--accent-glow);
        font-family: 'Inter', sans-serif;
        letter-spacing: 0.3px;
      }
      .submit-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 40px var(--accent-glow);
      }

      /* Success State */
      .form-success {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 0;
      }
      .form-success.active { display: flex; }
      .success-emoji { font-size: 4rem; margin-bottom: 1rem; }
      .form-success h4 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.5rem;
      }
      .form-success p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
      }
      .success-done-btn {
        padding: 0.7rem 1.5rem;
        background: var(--surface);
        border: 1px solid var(--border);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 99px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
      }
      .success-done-btn:hover {
        background: #fff;
        color: #000;
      }

      /* ═══════════════════════════════════════
         Footer
      ═══════════════════════════════════════ */
      .page-footer {
        text-align: center;
        padding: 2rem;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 600;
      }

      /* ═══════════════════════════════════════
         Scroll Progress Bar
      ═══════════════════════════════════════ */
      .scroll-progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        width: 0%;
        background: linear-gradient(90deg, var(--accent), var(--cyan), var(--pink));
        z-index: 999;
        transition: width 0.1s linear;
        box-shadow: 0 0 10px var(--accent-glow);
      }

      /* ═══════════════════════════════════════
         Scroll Reveal Animations & Variants
      ═══════════════════════════════════════ */
      .reveal, .scroll-fade-up, .scroll-fade-left, .scroll-fade-right, .scroll-scale-in, .scroll-blur-in, .scroll-rotate-in {
        opacity: 0;
        will-change: transform, opacity, filter;
        transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1),
                    transform 0.8s cubic-bezier(0.16,1,0.3,1),
                    filter 0.8s cubic-bezier(0.16,1,0.3,1);
      }

      .reveal, .scroll-fade-up { transform: translateY(50px); }
      .scroll-fade-left { transform: translateX(60px); }
      .scroll-fade-right { transform: translateX(-60px); }
      .scroll-scale-in { transform: scale(0.85) translateY(30px); }
      .scroll-blur-in { transform: translateY(20px); filter: blur(10px); }
      .scroll-rotate-in { transform: translateY(40px) rotateX(15deg); perspective: 1000px; }

      .reveal.in-view, 
      .scroll-fade-up.in-view, 
      .scroll-fade-left.in-view, 
      .scroll-fade-right.in-view, 
      .scroll-scale-in.in-view, 
      .scroll-blur-in.in-view, 
      .scroll-rotate-in.in-view {
        opacity: 1;
        transform: translate(0, 0) scale(1) rotateX(0deg);
        filter: blur(0px);
      }

      .reveal-delay-1 { transition-delay: 0.1s; }
      .reveal-delay-2 { transition-delay: 0.2s; }
      .reveal-delay-3 { transition-delay: 0.3s; }
      .reveal-delay-4 { transition-delay: 0.4s; }
      .reveal-delay-5 { transition-delay: 0.5s; }

      /* ═══════════════════════════════════════
         Utility Animations
      ═══════════════════════════════════════ */
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.7); }
      }

      /* ═══════════════════════════════════════
         Mobile Responsive
      ═══════════════════════════════════════ */
      @media (max-width: 768px) {
        .hero { padding: 8rem 1.5rem 4rem; }
        .hero-price { letter-spacing: -2px; }
        .floating-badge { display: none; }
        .tools-grid { grid-template-columns: repeat(2, 1fr); }
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .register-card { padding: 2.5rem 1.75rem; }
        .register-card-inner { grid-template-columns: 1fr; gap: 2.5rem; }
        .section { padding: 0 1.5rem 4rem; }
        .register-section { padding: 0 1.5rem 5rem; }
        .agenda-item { padding: 1.25rem 1.5rem; gap: 1rem; }
        .nav-brand { display: none; }
        .top-nav { padding: 1rem 1.25rem; }
        .about-card { padding: 2rem 1.5rem; }
      }

      @media (max-width: 480px) {
        .tools-grid { grid-template-columns: 1fr; }
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .hero-cta-group { flex-direction: column; }
        .cta-primary, .cta-secondary { width: 100%; justify-content: center; }
        .register-info h3 { font-size: 1.6rem; }
      }
    </style>
  </head>

  <body>
