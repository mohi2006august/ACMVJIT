    <!-- ═══════════════════════════════════════
         Three.js 3D Cyber Portal Fly-Through Scroll Engine
    ═══════════════════════════════════════ -->
    <script type="module">
      import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js';

      const canvas = document.getElementById('three-canvas');
      const scene = new THREE.Scene();
      
      const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.set(0, 0, 25);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setClearColor(0x000000, 0);

      // ── Studio Lighting System ──
      const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
      scene.add(ambientLight);

      const purplePoint = new THREE.PointLight(0x8b5cf6, 10, 60);
      purplePoint.position.set(15, 15, 10);
      scene.add(purplePoint);

      const cyanPoint = new THREE.PointLight(0x06b6d4, 10, 60);
      cyanPoint.position.set(-15, -10, 10);
      scene.add(cyanPoint);

      const pinkPoint = new THREE.PointLight(0xec4899, 8, 50);
      pinkPoint.position.set(0, 15, -5);
      scene.add(pinkPoint);

      // ═══════════════════════════════════════
      // PERSPECTIVE FLOOR GRID & STARFIELD PARTICLES
      // ═══════════════════════════════════════
      const floorGrid = new THREE.GridHelper(160, 80, 0x06b6d4, 0x8b5cf6);
      floorGrid.position.set(0, -16, 0);
      floorGrid.scale.set(1.6, 1, 1.6);
      scene.add(floorGrid);

      // Starfield Particles
      const particleCount = 1000;
      const particleGeo = new THREE.BufferGeometry();
      const posArray = new Float32Array(particleCount * 3);
      const colorArray = new Float32Array(particleCount * 3);

      const c1 = new THREE.Color(0x8b5cf6);
      const c2 = new THREE.Color(0x06b6d4);
      const c3 = new THREE.Color(0xec4899);

      for (let i = 0; i < particleCount; i++) {
        posArray[i * 3]     = (Math.random() - 0.5) * 80;
        posArray[i * 3 + 1] = (Math.random() - 0.5) * 60;
        posArray[i * 3 + 2] = (Math.random() - 0.5) * 40 - 10;

        const mix = i % 3 === 0 ? c1 : i % 3 === 1 ? c2 : c3;
        colorArray[i * 3]     = mix.r;
        colorArray[i * 3 + 1] = mix.g;
        colorArray[i * 3 + 2] = mix.b;
      }

      particleGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
      particleGeo.setAttribute('color', new THREE.BufferAttribute(colorArray, 3));

      const particleMat = new THREE.PointsMaterial({
        size: 0.1,
        vertexColors: true,
        transparent: true,
        opacity: 0.5,
      });
      const particleSystem = new THREE.Points(particleGeo, particleMat);
      scene.add(particleSystem);

      // ── Mouse Parallax ──
      const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      document.addEventListener('mousemove', (e) => {
        mouse.targetX = (e.clientX / window.innerWidth - 0.5) * 2;
        mouse.targetY = (e.clientY / window.innerHeight - 0.5) * 2;
      });

      // ── Smooth Scroll Progress ──
      let targetProgress = 0;
      let smoothProgress = 0;

      function onScroll() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        targetProgress = maxScroll > 0 ? Math.min(Math.max(scrollTop / maxScroll, 0), 1) : 0;
      }
      window.addEventListener('scroll', onScroll);
      onScroll();

      // ── Render Animation Loop ──
      const clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);
        const elapsed = clock.getElapsedTime();

        // Smooth Lerps
        smoothProgress += (targetProgress - smoothProgress) * 0.05;
        mouse.x += (mouse.targetX - mouse.x) * 0.04;
        mouse.y += (mouse.targetY - mouse.y) * 0.04;

        const p = smoothProgress;

        // Grid Floor Motion at bottom
        const speed = 2 + (p * 20);
        floorGrid.position.z = ((elapsed * speed) % 4);
        floorGrid.position.y = -16 - (p * 3);

        // Starfield Particles Flow
        particleSystem.rotation.y = elapsed * 0.02 + (p * 0.5);
        const posArr = particleSystem.geometry.attributes.position.array;
        const warpSpeed = 0.04 + (p * 0.2);

        for (let i = 0; i < particleCount; i++) {
          let yIdx = i * 3 + 1;
          posArr[yIdx] += warpSpeed;
          if (posArr[yIdx] > 30) posArr[yIdx] = -30;
        }
        particleSystem.geometry.attributes.position.needsUpdate = true;

        // Dynamic Camera Parallax
        camera.position.x = mouse.x * 1.5;
        camera.position.y = -mouse.y * 1.0 - (p * 3);
        camera.lookAt(0, -p * 3, 0);

        // Studio Lights Position Shift
        purplePoint.position.x = Math.sin(elapsed * 0.5 + p * 3) * 20;
        cyanPoint.position.x = -Math.sin(elapsed * 0.5 + p * 3) * 20;

        renderer.render(scene, camera);
      }
      animate();

      // ── Resize Handler ──
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    </script>

    <!-- ═══════════════════════════════════════
         Page Interactivity
    ═══════════════════════════════════════ -->
    <script>
      function initPage() {
        // ── Word-splitting Staggered Reveal Animation for Hero Title ──
        const titleEl = document.querySelector('.hero-title');
        if (titleEl && !titleEl.getAttribute('data-splitted')) {
          titleEl.setAttribute('data-splitted', 'true');
          const newNodes: Node[] = [];
          
          titleEl.childNodes.forEach((node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              const text = node.textContent || '';
              const words = text.split(/(\s+)/);
              words.forEach((w) => {
                if (w.trim() === '') {
                  newNodes.push(document.createTextNode(w));
                } else {
                  const span = document.createElement('span');
                  span.className = 'word';
                  span.textContent = w;
                  newNodes.push(span);
                }
              });
            } else if (node.nodeType === Node.ELEMENT_NODE) {
              const el = node as HTMLElement;
              if (el.tagName === 'BR') {
                newNodes.push(el.cloneNode(true));
              } else if (el.classList.contains('gradient-text')) {
                const words = el.textContent?.split(/(\s+)/) || [];
                const spanContainer = document.createElement('span');
                spanContainer.className = 'gradient-text';
                words.forEach((w) => {
                  if (w.trim() === '') {
                    spanContainer.appendChild(document.createTextNode(w));
                  } else {
                    const span = document.createElement('span');
                    span.className = 'word';
                    span.textContent = w;
                    spanContainer.appendChild(span);
                  }
                });
                newNodes.push(spanContainer);
              } else {
                newNodes.push(el.cloneNode(true));
              }
            }
          });
          
          titleEl.innerHTML = '';
          newNodes.forEach((n) => titleEl.appendChild(n));
          
          // Trigger staggered word reveal
          const wordSpans = titleEl.querySelectorAll('.word');
          wordSpans.forEach((span, idx) => {
            setTimeout(() => {
              span.classList.add('reveal-in');
            }, 100 + idx * 60);
          });
        }

        // ── Hero Subtitle Reveal ──
        const subtitleEl = document.querySelector('.hero-subtitle');
        if (subtitleEl) {
          setTimeout(() => {
            subtitleEl.classList.add('reveal-in');
          }, 600);
        }

        // ── Interactive 3D Cursor Parallax Tilt on Title ──
        const titleContainer = document.querySelector('.hero-title') as HTMLElement;
        if (titleContainer) {
          titleContainer.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = titleContainer.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = (y - centerY) / centerY * -10;
            const rotateY = (x - centerX) / centerX * 10;
            titleContainer.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          });
          titleContainer.addEventListener('mouseleave', () => {
            titleContainer.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
          });
        }

        // ── Scroll Progress Bar ──
        const progressBar = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          if (progressBar) {
            progressBar.style.width = scrolled + '%';
          }
        });

        // ── Scroll reveal observer for all animation classes ──
        const animateSelectors = '.reveal, .scroll-fade-up, .scroll-fade-left, .scroll-fade-right, .scroll-scale-in, .scroll-blur-in, .scroll-rotate-in';
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              
              // Trigger number counters if present
              const counters = entry.target.querySelectorAll('[data-counter-target]');
              counters.forEach(counter => animateCounter(counter as HTMLElement));
              if (entry.target.hasAttribute('data-counter-target')) {
                animateCounter(entry.target as HTMLElement);
              }
              
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll(animateSelectors).forEach(el => observer.observe(el));

        // ── Counter Animation Function ──
        function animateCounter(el: HTMLElement) {
          const targetStr = el.getAttribute('data-counter-target') || el.innerText;
          const match = targetStr.match(/(\d+)/);
          if (!match) return;
          const targetNum = parseInt(match[0], 10);
          const prefix = targetStr.split(match[0])[0] || '';
          const suffix = targetStr.split(match[0])[1] || '';
          
          let count = 0;
          const duration = 1500;
          const startTime = performance.now();

          function updateCounter(currentTime: number) {
            const elapsedTime = currentTime - startTime;
            const progress = Math.min(elapsedTime / duration, 1);
            // Ease out quad
            const currentNum = Math.floor((1 - (1 - progress) * (1 - progress)) * targetNum);
            el.innerText = `${prefix}${currentNum}${suffix}`;
            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              el.innerText = targetStr;
            }
          }
          requestAnimationFrame(updateCounter);
        }

        // ── Scroll-to buttons ──
        document.querySelectorAll('[data-scroll-to]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const target = document.getElementById(btn.getAttribute('data-scroll-to'));
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        });

        // ── Registration form ──
        const form = document.getElementById('register-form');
        const success = document.getElementById('form-success');
        const doneBtn = document.getElementById('success-done');

        if (form && success) {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            form.style.display = 'none';
            success.classList.add('active');
          });
        }

        if (doneBtn && form && success) {
          doneBtn.addEventListener('click', () => {
            success.classList.remove('active');
            form.style.display = 'flex';
            (form as HTMLFormElement).reset();
          });
        }

        // ── 3D tilt effect on tool cards ──
        document.querySelectorAll('.tool-card').forEach(card => {
          card.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = (card as HTMLElement).getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = (y - centerY) / centerY * -6;
            const rotateY = (x - centerX) / centerX * 6;
            (card as HTMLElement).style.transform = `translateY(-8px) perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          });

          card.addEventListener('mouseleave', () => {
            (card as HTMLElement).style.transform = '';
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initPage);
      document.addEventListener('astro:after-swap', initPage);
    </script>
  </body>
</html>
