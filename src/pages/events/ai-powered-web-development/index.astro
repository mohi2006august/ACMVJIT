            <span
              style="background:#c0c0c0;color:black;border:2px solid;border-color:#dfdfdf #000 #000 #dfdfdf;width:16px;height:16px;display:inline-flex;justify-content:center;align-items:center;font-size:10px;cursor:pointer;"
