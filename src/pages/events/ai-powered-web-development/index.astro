        function createKeyMat(code, width) {
          if (!code) return keyMat;
          const canvas = document.createElement("canvas");
          canvas.width = Math.max(32, width * 32);
          canvas.height = 32;
          const ctx = canvas.getContext("2d");
          ctx.fillStyle = "#c8c0b0";
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          ctx.fillStyle = "#444444";
          ctx.font = "bold 12px monospace";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";

          let display = code
            .replace("Key", "")
            .replace("Digit", "")
            .replace("Numpad", "");
          if (code === "Escape") display = "Esc";
          else if (code.includes("Control")) display = "Ctrl";
          else if (code.includes("Shift")) display = "Shift";
          else if (code.includes("Alt")) display = "Alt";
          else if (code === "Enter") display = "Enter";
          else if (code === "Backspace") display = "Back";
          else if (code === "Space") display = "";
          else if (code === "Tab") display = "Tab";
          else if (code === "CapsLock") display = "Caps";
          else if (code === "Minus") display = "-";
          else if (code === "Equal") display = "=";
          else if (code === "BracketLeft") display = "[";
          else if (code === "BracketRight") display = "]";
          else if (code === "Backslash") display = "\\";
          else if (code === "Semicolon") display = ";";
          else if (code === "Quote") display = "'";
          else if (code === "Comma") display = ",";
          else if (code === "Period") display = ".";
          else if (code === "Slash") display = "/";
          else if (code === "Backquote") display = "`";
          else if (code === "ArrowUp") display = "↑";
          else if (code === "ArrowDown") display = "↓";
          else if (code === "ArrowLeft") display = "←";
          else if (code === "ArrowRight") display = "→";
          else if (code === "PageUp") display = "PgUp";
          else if (code === "PageDown") display = "PgDn";
          else if (code === "PrintScreen") display = "PrtScn";
          else if (code === "ScrollLock") display = "ScrLk";
          else if (code === "Insert") display = "Ins";
          else if (code === "Delete") display = "Del";
          else if (code === "Home") display = "Home";
          else if (code === "End") display = "End";
          else if (code === "Pause") display = "Pause";
          else if (code === "NumLock") display = "NumLk";
          else if (code === "NumpadDivide") display = "/";
          else if (code === "NumpadMultiply") display = "*";
          else if (code === "NumpadSubtract") display = "-";
          else if (code === "NumpadAdd") display = "+";
          else if (code === "NumpadDecimal") display = ".";
          else if (code === "NumpadEnter") display = "Ent";

          ctx.fillText(display, canvas.width / 2, canvas.height / 2);
          const texture = new THREE.CanvasTexture(canvas);
          texture.anisotropy = renderer.capabilities.getMaxAnisotropy();

          // Materials array: sides use plain color, top uses texture
          return [
            keyMat,
            keyMat,
            new THREE.MeshStandardMaterial({ map: texture, roughness: 0.6 }), // top
            keyMat,
            keyMat,
            keyMat,
          ];
        }

