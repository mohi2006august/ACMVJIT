        }

        // Seat assembly
        const seatGroup = new THREE.Group();
        seatGroup.position.set(0, 12.5, 0);
        chairGroup.add(seatGroup);

        // Seat shell (dark rigid bottom)
        const seatShell = new THREE.Mesh(
          new THREE.BoxGeometry(10, 0.5, 10),
          metalMat,
        );
        seatShell.position.set(0, -0.2, 0);
        seatShell.castShadow = true;
        seatGroup.add(seatShell);

        // Seat cushion (smooth extruded shape)
        const seatCushion = new THREE.Mesh(seatGeo, chairMat);
        seatCushion.rotation.x = -Math.PI / 2;
        seatCushion.position.set(0, 1.2, 0); // depth is extruded towards +Z, which becomes -Y after rotation
        seatCushion.castShadow = true;
        seatGroup.add(seatCushion);

        // Armrests
        const armrestGeo = new THREE.CapsuleGeometry(0.8, 6, 8, 12);
        const armSupportGeo = new THREE.CylinderGeometry(0.3, 0.3, 6, 8);

        // Left armrest
        const armL = new THREE.Group();
        const armSL = new THREE.Mesh(armSupportGeo, metalMat);
        armSL.position.set(-7, 2.5, 0);
        armL.add(armSL);
        const armPadL = new THREE.Mesh(armrestGeo, chairMat);
        armPadL.rotation.x = Math.PI / 2;
        armPadL.position.set(-7, 5.5, 0);
        armPadL.castShadow = true;
        armL.add(armPadL);
        seatGroup.add(armL);

        // Right armrest
        const armR = new THREE.Group();
        const armSR = new THREE.Mesh(armSupportGeo, metalMat);
        armSR.position.set(7, 2.5, 0);
        armR.add(armSR);
        const armPadR = new THREE.Mesh(armrestGeo, chairMat);
        armPadR.rotation.x = Math.PI / 2;
        armPadR.position.set(7, 5.5, 0);
        armPadR.castShadow = true;
        armR.add(armPadR);
        seatGroup.add(armR);

        // Backrest assembly (tilted slightly for comfort)
        const backGroup = new THREE.Group();
        backGroup.position.set(0, 13, -5.5);
        backGroup.rotation.x = -0.15; // ergonomic tilt
        chairGroup.add(backGroup);

        // Main central support strut from seat to back
        const strut = new THREE.Mesh(new THREE.BoxGeometry(2, 8, 1), metalMat);
        strut.position.set(0, 2, -1);
        strut.castShadow = true;
        backGroup.add(strut);

        // Backrest shell (rigid plastic back)
        const backShell = new THREE.Mesh(
          new THREE.BoxGeometry(9, 11, 0.5),
          metalMat,
        );
        backShell.position.set(0, 10, -1.2);
        backShell.castShadow = true;
        backGroup.add(backShell);

        // Backrest cushion (smooth extruded shape)
        const backCushion = new THREE.Mesh(backGeo, chairMat);
        backCushion.position.set(0, 10, -0.6); // Z extruded backwards
        backCushion.castShadow = true;
        backGroup.add(backCushion);

        scene.add(chairGroup);


        // ── CSS3D Screen ──
        const screenEl = document.querySelector(".page-wrapper");
        const cssObject = new CSS3DObject(screenEl);
        const cssScale = 22 / 1024;
        cssObject.scale.set(cssScale, cssScale, cssScale);
        cssObject.position.set(0, 8.5, 3.6);
        scene.add(cssObject);

        // ── State Machine ──
        let currentState = "START";

        const OVERVIEW_POS = new THREE.Vector3(120, 60, 130);
        const OVERVIEW_TARGET = new THREE.Vector3(0, -10, 0);

        const DESK_POS = new THREE.Vector3(0, 12, 50);
        const DESK_TARGET = new THREE.Vector3(0, 0, 0);

        const SCREEN_POS = new THREE.Vector3(0, 8.5, 30);
        const SCREEN_TARGET = new THREE.Vector3(0, 8.5, 3.6);

        camera.position.copy(OVERVIEW_POS);
        camera.lookAt(OVERVIEW_TARGET);

        const cameraTarget = new THREE.Vector3().copy(OVERVIEW_TARGET);
        const cameraTargetDest = new THREE.Vector3().copy(OVERVIEW_TARGET);
        const cameraPosDest = new THREE.Vector3().copy(OVERVIEW_POS);

        // ── Interaction ──
        const startScreen = document.getElementById("start-screen");

        startScreen.addEventListener("click", () => {
          startScreen.style.opacity = "0";
          setTimeout(() => {
            startScreen.style.display = "none";
            currentState = "OVERVIEW";
          }, 1500);
        });

        const raycaster = new THREE.Raycaster();
        const pointer = new THREE.Vector2();

        window.addEventListener("click", (event) => {
          if (currentState === "OVERVIEW") {
            // Any click transitions to DESK view
            currentState = "TO_DESK";
            cameraPosDest.copy(DESK_POS);
            cameraTargetDest.copy(DESK_TARGET);
            return;
          }

          if (currentState === "DESK") {
            pointer.x = (event.clientX / window.innerWidth) * 2 - 1;
            pointer.y = -(event.clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera(pointer, camera);

            const intersects = raycaster.intersectObjects(
              monitorGroup.children,
            );
            if (intersects.length > 0) {
              currentState = "TO_SCREEN";
              cameraPosDest.copy(SCREEN_POS);
              cameraTargetDest.copy(SCREEN_TARGET);
              cssContainer.style.pointerEvents = "auto";
            }
          } else if (currentState === "SCREEN") {
            if (event.target === canvas) {
              currentState = "TO_DESK";
              cameraPosDest.copy(DESK_POS);
              cameraTargetDest.copy(DESK_TARGET);
              cssContainer.style.pointerEvents = "none";
            }
          }
        });

        cssContainer.style.pointerEvents = "none";

        // ── Mouse tracking ──
        const mousePos = { x: 0, y: 0 };
        document.addEventListener("mousemove", (e) => {
          mousePos.x = (e.clientX / window.innerWidth - 0.5) * 2;
          mousePos.y = (e.clientY / window.innerHeight - 0.5) * 2;
        });

        // ── HUD Clock ──
        const hudClock = document.getElementById("hud-clock");
        const taskbarClock = document.getElementById("taskbar-clock");
        function updateClocks() {
          const now = new Date();
          const timeStr = now.toLocaleTimeString("en-US", {
            hour: "numeric",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
          });
          if (hudClock) hudClock.textContent = timeStr;
          if (taskbarClock)
            taskbarClock.textContent = now.toLocaleTimeString("en-US", {
              hour: "numeric",
              minute: "2-digit",
              hour12: true,
            });
        }
        updateClocks();
        setInterval(updateClocks, 1000);

        // ── Render Loop ──
        function animate() {
          requestAnimationFrame(animate);

          const lerpSpeed = 0.035;

          if (currentState === "TO_DESK" || currentState === "TO_SCREEN") {
            camera.position.lerp(cameraPosDest, lerpSpeed);
            cameraTarget.lerp(cameraTargetDest, lerpSpeed);
            camera.lookAt(cameraTarget);

            if (camera.position.distanceTo(cameraPosDest) < 0.3) {
              if (currentState === "TO_DESK") currentState = "DESK";
              else currentState = "SCREEN";
            }
          } else if (currentState === "OVERVIEW") {
            // Gentle idle rotation
            const t = Date.now() * 0.0002;
            camera.position.x = OVERVIEW_POS.x + Math.sin(t) * 8;
            camera.position.z = OVERVIEW_POS.z + Math.cos(t) * 8;
            camera.lookAt(OVERVIEW_TARGET);
          } else if (currentState === "DESK") {
            camera.position.copy(DESK_POS);
            camera.lookAt(DESK_TARGET);
          } else if (currentState === "SCREEN") {
            // Subtle parallax
            camera.position.x = SCREEN_POS.x + mousePos.x * 1.2;
            camera.position.y = SCREEN_POS.y - mousePos.y * 0.8;
            camera.lookAt(SCREEN_TARGET);

            // Move virtual mouse
            mouse3D.position.x = 20 + mousePos.x * 4;
            mouse3D.position.z = 16 + mousePos.y * 3;
          }

          renderer.render(scene, camera);
          cssRenderer.render(scene, camera);
        }
        animate();

        // ── Resize ──
        window.addEventListener("resize", () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
          cssRenderer.setSize(window.innerWidth, window.innerHeight);
        });
      }
    </script>

    <!-- ═══════════════════════════════════════
         Page Interactivity
    ═══════════════════════════════════════ -->
    <script>
      function initPage() {
        // ── Word-splitting Staggered Reveal Animation for Hero Title ──
        const titleEl = document.querySelector(".hero-title");
        if (titleEl && !titleEl.getAttribute("data-splitted")) {
          titleEl.setAttribute("data-splitted", "true");
          const newNodes: Node[] = [];

          titleEl.childNodes.forEach((node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              const text = node.textContent || "";
              const words = text.split(/(\s+)/);
              words.forEach((w) => {
                if (w.trim() === "") {
                  newNodes.push(document.createTextNode(w));
                } else {
                  const span = document.createElement("span");
                  span.className = "word";
                  span.textContent = w;
                  newNodes.push(span);
                }
              });
            } else if (node.nodeType === Node.ELEMENT_NODE) {
              const el = node as HTMLElement;
              if (el.tagName === "BR") {
                newNodes.push(el.cloneNode(true));
              } else if (el.classList.contains("gradient-text")) {
                const words = el.textContent?.split(/(\s+)/) || [];
                const spanContainer = document.createElement("span");
                spanContainer.className = "gradient-text";
                words.forEach((w) => {
                  if (w.trim() === "") {
                    spanContainer.appendChild(document.createTextNode(w));
                  } else {
                    const span = document.createElement("span");
                    span.className = "word";
                    span.textContent = w;
                    spanContainer.appendChild(span);
                  }
                });
                newNodes.push(spanContainer);
              } else {
                newNodes.push(el.cloneNode(true));
              }
            }
          });

          titleEl.innerHTML = "";
          newNodes.forEach((n) => titleEl.appendChild(n));

          // Trigger staggered word reveal
          const wordSpans = titleEl.querySelectorAll(".word");
          wordSpans.forEach((span, idx) => {
            setTimeout(
              () => {
                span.classList.add("reveal-in");
              },
              100 + idx * 60,
            );
          });
        }

        // ── Hero Subtitle Reveal ──
        const subtitleEl = document.querySelector(".hero-subtitle");
        if (subtitleEl) {
          setTimeout(() => {
            subtitleEl.classList.add("reveal-in");
          }, 600);
        }

        // ── Interactive 3D Cursor Parallax Tilt on Title ──
        const titleContainer = document.querySelector(
          ".hero-title",
        ) as HTMLElement;
        if (titleContainer) {
          titleContainer.addEventListener("mousemove", (e: MouseEvent) => {
            const rect = titleContainer.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -10;
            const rotateY = ((x - centerX) / centerX) * 10;
            titleContainer.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          });
          titleContainer.addEventListener("mouseleave", () => {
            titleContainer.style.transform =
              "perspective(1000px) rotateX(0deg) rotateY(0deg)";
          });
        }

        // ── Scroll Progress Bar ──
        const progressBar = document.getElementById("scroll-progress");
        window.addEventListener("scroll", () => {
          const winScroll =
            document.body.scrollTop || document.documentElement.scrollTop;
          const height =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          if (progressBar) {
            progressBar.style.width = scrolled + "%";
          }
        });

        // ── Scroll reveal observer for all animation classes ──
        const animateSelectors =
          ".reveal, .scroll-fade-up, .scroll-fade-left, .scroll-fade-right, .scroll-scale-in, .scroll-blur-in, .scroll-rotate-in";
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");

                // Trigger number counters if present
                const counters = entry.target.querySelectorAll(
                  "[data-counter-target]",
                );
                counters.forEach((counter) =>
                  animateCounter(counter as HTMLElement),
                );
                if (entry.target.hasAttribute("data-counter-target")) {
                  animateCounter(entry.target as HTMLElement);
                }

                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );

        document
          .querySelectorAll(animateSelectors)
          .forEach((el) => observer.observe(el));

        // ── Counter Animation Function ──
        function animateCounter(el: HTMLElement) {
          const targetStr =
            el.getAttribute("data-counter-target") || el.innerText;
          const match = targetStr.match(/(\d+)/);
          if (!match) return;
          const targetNum = parseInt(match[0], 10);
          const prefix = targetStr.split(match[0])[0] || "";
          const suffix = targetStr.split(match[0])[1] || "";

          let count = 0;
          const duration = 1500;
          const startTime = performance.now();

          function updateCounter(currentTime: number) {
            const elapsedTime = currentTime - startTime;
            const progress = Math.min(elapsedTime / duration, 1);
            // Ease out quad
            const currentNum = Math.floor(
              (1 - (1 - progress) * (1 - progress)) * targetNum,
            );
            el.innerText = `${prefix}${currentNum}${suffix}`;
            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              el.innerText = targetStr;
            }
          }
          requestAnimationFrame(updateCounter);
        }

        // ── Scroll-to buttons ──
        document.querySelectorAll("[data-scroll-to]").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            const targetId = btn.getAttribute("data-scroll-to");
            if (!targetId) return;
            const target = document.getElementById(targetId);
            if (target) {
              target.scrollIntoView({ behavior: "smooth", block: "center" });
            }
          });
        });

        // ── Registration form ──
        const form = document.getElementById("register-form");
        const success = document.getElementById("form-success");
        const doneBtn = document.getElementById("success-done");

        // Note: To make this work, create a Google Apps Script attached to a Google Sheet:
        // 1. Create a Google Sheet, add headers: timestamp, name, email, roll, yearSection, phone
        // 2. Extensions -> Apps Script
        // 3. Paste the following code:
        /*
          function doPost(e) {
            const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
            const row = [
              new Date(),
              e.parameter.name,
              e.parameter.email,
              e.parameter.roll,
              e.parameter.yearSection,
              e.parameter.phone
            ];
            sheet.appendRow(row);
            return ContentService.createTextOutput(JSON.stringify({result: 'success'})).setMimeType(ContentService.MimeType.JSON);
          }
        */
        // 4. Deploy -> New Deployment -> Select "Web app" -> Execute as "Me", Who has access "Anyone"
        // 5. Copy the Web App URL and paste it below:
        const GOOGLE_SCRIPT_URL =
          "https://script.google.com/macros/s/AKfycbwdhEfl3s5FOmUC0W7U1O9qen9U2wwWlk5dmkU5PV3Gpn9-JQSdxzLT9i7dXvl5NTnq/exec";

        if (form && success) {
          form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const submitBtn = form.querySelector(".submit-btn");
            if (submitBtn) {
              submitBtn.innerHTML = "Submitting...";
              (submitBtn as HTMLButtonElement).disabled = true;
            }

            const formData = new FormData();
            formData.append(
              "name",
              (document.getElementById("reg-name") as HTMLInputElement).value,
            );
            formData.append(
              "email",
              (document.getElementById("reg-email") as HTMLInputElement).value,
            );
            formData.append(
              "roll",
              (document.getElementById("reg-roll") as HTMLInputElement).value,
            );
            formData.append(
              "yearSection",
              (document.getElementById("reg-year-section") as HTMLInputElement)
                .value,
            );
            formData.append(
              "phone",
              (document.getElementById("reg-phone") as HTMLInputElement).value,
            );

            try {
              await fetch(GOOGLE_SCRIPT_URL, {
                method: "POST",
                body: formData,
                mode: "no-cors",
              });

              form.style.display = "none";
              success.classList.add("active");
            } catch (error) {
              console.error("Error submitting form:", error);
              alert(
                "There was an error submitting your registration. Please try again.",
              );
            } finally {
              if (submitBtn) {
                submitBtn.innerHTML = "Complete Registration &rarr;";
                (submitBtn as HTMLButtonElement).disabled = false;
              }
            }
          });
        }

        if (doneBtn && form && success) {
          doneBtn.addEventListener("click", () => {
            success.classList.remove("active");
            form.style.display = "flex";
            (form as HTMLFormElement).reset();
          });
        }

        // ── 3D tilt effect on tool cards ──
        document.querySelectorAll(".tool-card").forEach((card) => {
          card.addEventListener("mousemove", (e) => {
            const mouseEvent = e as MouseEvent;
            const rect = (card as HTMLElement).getBoundingClientRect();
            const x = mouseEvent.clientX - rect.left;
            const y = mouseEvent.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -6;
            const rotateY = ((x - centerX) / centerX) * 6;
            (card as HTMLElement).style.transform =
              `translateY(-8px) perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          });

          card.addEventListener("mouseleave", () => {
            (card as HTMLElement).style.transform = "";
          });
        });
      }

      document.addEventListener("DOMContentLoaded", initPage);
      document.addEventListener("astro:after-swap", initPage);
    </script>
  </body>
