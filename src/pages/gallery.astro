---
import Layout from '../layouts/Layout.astro';
import galleryData from '../data/gallery.json';
import DriftWall from '../components/DriftWall.jsx';

// Map galleryData to match DriftWall item schema: { image, title }
const driftWallItems = galleryData.map(photo => ({
  image: photo.url,
  title: photo.caption
}));
---

<Layout 
  title="Gallery"
  description="Explore the photo gallery of ACM VJIT. See our students in action during hackathons, tech workshops, coding competitions, and community events."
>
  <div class="gallery-container" id="gallery-container">
    <!-- DriftWall Interactive Section -->
    <div class="wall-wrapper animate-fade-up">
      <DriftWall
        client:load
        items={driftWallItems}
        columns={5}
        tileWidth={220}
        tileHeight={146}
        gap={20}
        tilt={0}
        turn={0}
        perspective={1200}
        depth={0}
        speed={42}
        direction="up"
        variance={0.45}
        parallax={0}
        lift={64}
        fade={0.6}
        dim={0.55}
        grayscale={true}
        overlayColor="#060010"
      />
    </div>
  </div>
</Layout>

<style>
  .gallery-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wall-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
  }

  .animate-fade-up {
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

