---
import Layout from '../layouts/Layout.astro';
import eventsData from '../data/events.json';

const upcomingEvents = eventsData.filter(e => e.status === 'upcoming' || e.status === 'live');
const pastEvents     = eventsData.filter(e => e.status === 'past');
---

<Layout
  title="Events"
  description="Discover upcoming and past tech events, hackathons, competitive coding challenges, and expert workshops hosted by the ACM VJIT Student Chapter."
>

  <div class="events-page">

    <!-- ── Hero: Clean Centered Design ── -->
    <section class="events-hero">
      <div class="container hero-container-centered">
        <div class="hero-tag scroll-reveal">Our Events</div>
        <h1 class="hero-title scroll-reveal delay-1">
          <span class="text-gradient">ACM VJIT</span> Events
        </h1>
        <p class="hero-subtitle scroll-reveal delay-2">
          Discover hands-on technical workshops, competitive hackathons, and engineering events hosted by the ACM VJIT Student Chapter.
        </p>
        <div class="hero-stats scroll-reveal delay-3">
          <div class="stat-item">
            <span class="stat-number" id="stat-events">00+</span>
            <span class="stat-label">Events Hosted</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" id="stat-attendees">000+</span>
            <span class="stat-label">Total Attendees</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Pinned: Upcoming / Live ── -->
    <section class="section upcoming-section">
      <div class="container">
        <div class="section-header scroll-reveal">
          <div class="section-label">
            <span class="label-dot upcoming-dot"></span>
            Upcoming & Live
          </div>
          <h2 class="section-title">What's Next</h2>
        </div>

        {upcomingEvents.length === 0 ? (
          <!-- Empty State -->
          <div class="empty-state scroll-reveal delay-1">
            <div class="empty-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3>Stay Tuned!</h3>
            <p>We're cooking up something incredible. New events dropping soon — follow us to be the first to know.</p>
            <div class="empty-dots">
              <span></span><span></span><span></span>
            </div>
          </div>
        ) : (
          <div class="upcoming-list">
            {upcomingEvents.map((event, i) => (
              <article class={`upcoming-card scroll-reveal delay-${i + 1}`} style={`--accent: ${event.accentColor}; --accent-light: ${event.accentColorLight}; --accent-glow: ${event.accentGlow}; --cat-bg: ${event.categoryBg}; --cat-color: ${event.accentColorLight};`}>
                <div class="upcoming-card-text">
                  <div class="card-badges">
                    <span class="category-pill" style={`background: ${event.categoryBg}; color: ${event.accentColorLight}; border-color: ${event.accentColor}44;`}>
                      {event.category}
                    </span>
                    {event.status === 'live' && (
                      <span class="live-pill">
                        <span class="live-dot"></span>
                        LIVE
                      </span>
                    )}
                  </div>
                  <h3 class="upcoming-card-title">{event.title}</h3>
                  <p class="upcoming-card-date">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                    {event.dateDisplay}
                  </p>
                  <p class="upcoming-card-desc">{event.shortDesc}</p>
                  <a href={`/events/${event.slug}`} class="upcoming-cta">
                    {event.registerLink ? 'Register Now' : 'Learn More'}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>

                <div class="upcoming-card-visual">
                  {event.photo ? (
                    <img src={event.photo} alt={event.title} class="upcoming-card-img" loading="lazy" />
                  ) : (
                    <div class="upcoming-card-img-placeholder">
                      <div class="placeholder-icon">🚀</div>
                    </div>
                  )}
                  <div class="upcoming-card-img-overlay"></div>
                </div>

                <!-- Accent glow blob -->
                <div class="card-glow" aria-hidden="true"></div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ── Divider ── -->
    <div class="section-divider container">
      <div class="divider-line"></div>
    </div>

    <!-- ── Past Events ── -->
    <section class="section past-section">
      <div class="container">
        <div class="section-header scroll-reveal">
          <div class="section-label">
            <span class="label-dot past-dot"></span>
            Past Events
          </div>
          <h2 class="section-title">The Archive</h2>
        </div>

        {pastEvents.length === 0 ? (
          <p class="empty-text scroll-reveal">No past events yet.</p>
        ) : (
          <div class="past-grid">
            {pastEvents.map((event, i) => {
              const dateParts = event.dateDisplay.split(' ');
              const datePrimary = dateParts.slice(0, 2).join(' ');
              const dateSecondary = dateParts[2] ? dateParts[2].replace("'", '20') : '';
              
              return (
                <article class={`past-card scroll-reveal delay-${(i % 3) + 1}`} style={`--accent: ${event.accentColor}; --accent-light: ${event.accentColorLight}; --accent-glow: ${event.accentGlow};`}>
                  <!-- Inset Photo Container -->
                  <div class="past-card-photo-wrapper">
                    <div class="past-card-photo">
                      {event.photo ? (
                        <img src={event.photo} alt={event.title} class="past-card-img" loading="lazy" />
                      ) : (
                        <div class="past-card-img-placeholder">🏆</div>
                      )}
                    </div>
                  </div>

                  <!-- Text Body -->
                  <div class="past-card-body">
                    <div class="past-card-main-content">
                      <h3 class="past-card-title">{event.title}</h3>
                      <p class="past-card-desc">{event.shortDesc}</p>
                    </div>
                    
                    <div class="past-card-footer">
                      <div class="past-card-info-col">
                        <div class="past-card-date">
                          <span class="date-day">{datePrimary}</span>
                          <span class="date-year">{dateSecondary}</span>
                        </div>
                        {event.venue && (
                          <div class="past-card-venue">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                            </svg>
                            {event.venue}
                          </div>
                        )}
                      </div>
                      
                      <a href={`/events/${event.slug}`} class="past-card-button">
                        More Info
                      </a>
                    </div>
                  </div>

                  <div class="past-card-glow" aria-hidden="true"></div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>

  </div>

</Layout>

<script>
  function initScrollReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { root: null, rootMargin: '0px', threshold: 0.08 });

    document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
  }

  function animateStats() {
    const stats = [
      { id: 'stat-events', end: 2, suffix: '+' },
      { id: 'stat-attendees', end: 350, suffix: '+' }
    ];

    stats.forEach(stat => {
      const el = document.getElementById(stat.id);
      if (!el) return;

      const duration = 1500; // 1.5s count-up duration
      const startTime = Date.now();
      const startVal = 0;

      const interval = setInterval(() => {
        const elapsed = Date.now() - startTime;
        const progress = Math.min(1, elapsed / duration);
        
        // Easing: easeOutQuad
        const easeProgress = progress * (2 - progress);
        const currentVal = Math.floor(startVal + (stat.end - startVal) * easeProgress);

        let formatted = currentVal.toString();
        if (stat.end === 2) {
          formatted = formatted.padStart(2, '0');
        } else {
          formatted = formatted.padStart(3, '0');
        }

        el.innerText = formatted + stat.suffix;

        if (progress >= 1) {
          clearInterval(interval);
          el.innerText = (stat.end === 2 ? '0' : '') + stat.end + stat.suffix;
        }
      }, 16);
    });
  }

  function initEventsPage() {
    initScrollReveal();
    animateStats();
  }

  document.addEventListener('DOMContentLoaded', initEventsPage);
  document.addEventListener('astro:page-load', initEventsPage);
</script>

<style>
  /* ═══════════════════════════════════════
     Base
  ═══════════════════════════════════════ */
  .events-page {
    position: relative;
    z-index: 10;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ═══════════════════════════════════════
     Scroll Reveal
  ═══════════════════════════════════════ */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.75s cubic-bezier(0.16,1,0.3,1),
                transform 0.75s cubic-bezier(0.16,1,0.3,1);
  }
  .scroll-reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .delay-1 { transition-delay: 0.08s; }
  .delay-2 { transition-delay: 0.16s; }
  .delay-3 { transition-delay: 0.24s; }

  /* ═══════════════════════════════════════
     Hero
  ═══════════════════════════════════════ */
  .events-hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
    text-align: center;
  }

  .hero-container-centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-tag {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: rgba(0, 114, 206, 0.08);
    color: var(--primary-color, #0072CE);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(0, 114, 206, 0.2);
  }

  .hero-title {
    font-size: 4.5rem;
    margin-bottom: 1.5rem;
    letter-spacing: -1.5px;
    color: #1a1a1a;
    line-height: 1.1;
    margin-top: 0;
  }

  .text-gradient {
    background: linear-gradient(to right, #0072CE, #00d2ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* --- Hero Stats Row --- */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    margin-top: 3.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 800;
    color: var(--primary-color, #0072CE);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #555;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background-color: rgba(0, 114, 206, 0.15);
  }

  @media (max-width: 600px) {
    .hero-stats {
      flex-direction: column;
      gap: 2rem;
    }
    .stat-divider {
      display: none;
    }
  }

  /* Decorative lines */
  .hero-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: -1;
  }
  .line {
    position: absolute;
    background: linear-gradient(to right, transparent, rgba(0,114,206,0.08), transparent);
    height: 1px;
    width: 100%;
  }
  .line-1 { top: 30%; }
  .line-2 { top: 55%; opacity: 0.5; }
  .line-3 { top: 78%; opacity: 0.25; }

  /* ═══════════════════════════════════════
     Section Header
  ═══════════════════════════════════════ */
  .section { padding: 4rem 0; }

  .section-header { margin-bottom: 3rem; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #777;
    margin-bottom: 0.75rem;
  }
  .label-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    display: inline-block;
  }
  .upcoming-dot {
    background: #0072CE;
    box-shadow: 0 0 6px rgba(0,114,206,0.6);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .past-dot { background: #999; }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 4px rgba(0,114,206,0.4); }
    50% { box-shadow: 0 0 12px rgba(0,114,206,0.8); }
  }

  .section-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #1a1a1a;
    letter-spacing: -1.5px;
    line-height: 1;
  }

  /* ═══════════════════════════════════════
     Empty State
  ═══════════════════════════════════════ */
  .empty-state {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(0,114,206,0.1);
    border-radius: 28px;
    padding: 5rem 2rem;
    text-align: center;
    box-shadow: 0 8px 40px rgba(0,0,0,0.04);
  }
  .empty-icon {
    width: 72px; height: 72px;
    background: rgba(0,114,206,0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: #0072CE;
  }
  .empty-icon svg { width: 36px; height: 36px; }
  .empty-state h3 {
    font-size: 2rem;
    font-weight: 900;
    color: #1a1a1a;
    letter-spacing: -1px;
    margin-bottom: 0.75rem;
  }
  .empty-state p {
    color: #666;
    font-size: 1.05rem;
    max-width: 420px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .empty-dots {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1rem;
  }
  .empty-dots span {
    width: 8px; height: 8px;
    background: rgba(0,114,206,0.3);
    border-radius: 50%;
    animation: dot-blink 1.4s ease-in-out infinite;
  }
  .empty-dots span:nth-child(2) { animation-delay: 0.2s; }
  .empty-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dot-blink {
    0%, 80%, 100% { opacity: 0.3; transform: scale(1); }
    40% { opacity: 1; transform: scale(1.3); }
  }

  /* ═══════════════════════════════════════
     Upcoming Event Card
  ═══════════════════════════════════════ */
  .upcoming-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .upcoming-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1),
                box-shadow 0.4s cubic-bezier(0.16,1,0.3,1),
                border-color 0.3s ease;
    box-shadow: 0 4px 24px rgba(0,0,0,0.05);
  }

  .upcoming-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.1), 0 0 0 1px var(--accent, #0072CE)22;
    border-color: rgba(0,0,0,0.04);
  }

  .card-glow {
    position: absolute;
    width: 200px; height: 200px;
    background: var(--accent-glow, rgba(0,114,206,0.2));
    border-radius: 50%;
    filter: blur(60px);
    top: -50px; left: -50px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .upcoming-card:hover .card-glow { opacity: 1; }

  .upcoming-card-text {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .category-pill {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: 1px solid;
  }
  .category-pill.small {
    font-size: 0.68rem;
    padding: 0.25rem 0.7rem;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    background: rgba(255,75,75,0.1);
    border: 1px solid rgba(255,75,75,0.35);
    border-radius: 99px;
    color: #cc3333;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .live-dot {
    width: 7px; height: 7px;
    background: #ff4b4b;
    border-radius: 50%;
    animation: pulse-live 1.4s ease-in-out infinite;
  }
  @keyframes pulse-live {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .upcoming-card-title {
    font-size: 2.25rem;
    font-weight: 900;
    color: #1a1a1a;
    letter-spacing: -1.5px;
    line-height: 1.1;
    margin-bottom: 0.6rem;
  }

  .upcoming-card-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #888;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .upcoming-card-date svg { width: 14px; height: 14px; }

  .upcoming-card-desc {
    color: #555;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 100%;
  }

  .upcoming-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.75rem;
    background: linear-gradient(135deg, var(--accent, #0072CE), var(--accent-light, #00d2ff));
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 24px var(--accent-glow, rgba(0,114,206,0.25));
    width: fit-content;
    letter-spacing: 0.2px;
  }
  .upcoming-cta svg { width: 16px; height: 16px; transition: transform 0.3s ease; }
  .upcoming-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px var(--accent-glow, rgba(0,114,206,0.35));
  }
  .upcoming-cta:hover svg { transform: translateX(4px); }

  /* Photo side */
  .upcoming-card-visual {
    position: relative;
    overflow: hidden;
  }
  .upcoming-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  }
  .upcoming-card:hover .upcoming-card-img { transform: scale(1.04); }
  .upcoming-card-img-placeholder {
    width: 100%;
    height: 100%;
    min-height: 300px;
    background: linear-gradient(135deg, rgba(0,114,206,0.06), rgba(0,210,255,0.08));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
  }
  .upcoming-card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(255,255,255,0.15) 0%, transparent 30%);
    pointer-events: none;
  }

  /* ═══════════════════════════════════════
     Divider
  ═══════════════════════════════════════ */
  .section-divider { padding: 0.5rem 0; }
  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0,0,0,0.08), transparent);
  }

  /* ═══════════════════════════════════════
     Past Events Grid
  ═══════════════════════════════════════ */
  .past-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .past-card {
    background: var(--accent, #0072CE);
    border: none;
    border-radius: 28px;
    padding: 1.25rem;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.5rem;
    align-items: stretch;
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1),
                box-shadow 0.4s cubic-bezier(0.16,1,0.3,1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .past-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 60px rgba(0,0,0,0.15), 0 0 0 1px rgba(0,0,0,0.05);
  }

  /* Photo Inset Wrapper */
  .past-card-photo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .past-card-photo {
    position: relative;
    overflow: hidden;
